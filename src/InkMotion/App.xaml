<Application
    x:Class="InkMotion.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="#0E1014" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="#0E1014" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- InkMotion design tokens: a dark, low-glare palette for colour-critical editing. -->
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#0E1014" />
            <SolidColorBrush x:Key="ChromeBrush" Color="#14171C" />
            <SolidColorBrush x:Key="PanelBrush" Color="#181B21" />
            <SolidColorBrush x:Key="PanelRaisedBrush" Color="#1F232A" />
            <SolidColorBrush x:Key="StageBrush" Color="#07080A" />
            <SolidColorBrush x:Key="PanelBorderBrush" Color="#2A2F38" />
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#ECEFF4" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A3ABB8" />
            <SolidColorBrush x:Key="TextMutedBrush" Color="#6E7686" />
            <SolidColorBrush x:Key="WarningTextBrush" Color="#F3B562" />

            <Style x:Key="PanelStyle" TargetType="Grid">
                <Setter Property="Background" Value="{StaticResource PanelBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="6" />
            </Style>
            <Style x:Key="PanelTitleTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            </Style>
            <Style x:Key="SectionHeaderTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="CharacterSpacing" Value="80" />
                <Setter Property="Margin" Value="0,4,0,0" />
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            </Style>
            <Style x:Key="LabelTextStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="HintTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            </Style>
            <Style x:Key="DividerStyle" TargetType="Border">
                <Setter Property="Height" Value="1" />
                <Setter Property="Margin" Value="0,2" />
                <Setter Property="Background" Value="{StaticResource PanelBorderBrush}" />
            </Style>
            <Style x:Key="PageButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="MinWidth" Value="128" />
                <Setter Property="Height" Value="34" />
                <Setter Property="Padding" Value="14,0" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Background" Value="Transparent" />
            </Style>
            <Style x:Key="TransportButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Width" Value="40" />
                <Setter Property="Height" Value="34" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Background" Value="Transparent" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
