<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <WindowsPackageType>None</WindowsPackageType>
    <UseWinUI>true</UseWinUI>
    <RootNamespace>InkMotion</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <Platforms>x86;x64;ARM64</Platforms>
    <PlatformTarget Condition="'$(Platform)' == 'x86'">x86</PlatformTarget>
    <PlatformTarget Condition="'$(Platform)' == 'x64'">x64</PlatformTarget>
    <PlatformTarget Condition="'$(Platform)' == 'ARM64'">ARM64</PlatformTarget>
    <PlatformTarget Condition="'$(Platform)' == ''">x64</PlatformTarget>
  </PropertyGroup>

  <PropertyGroup Condition="'$(StorePackage)' == 'true'">
    <WindowsPackageType>MSIX</WindowsPackageType>
    <EnableMsixTooling>true</EnableMsixTooling>
    <PublishProfile>Properties\PublishProfiles\win10-$(Platform).pubxml</PublishProfile>
    <AppxManifest>Package.appxmanifest</AppxManifest>
    <RuntimeIdentifiers>win-x86;win-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup Condition="'$(StorePackage)' == 'true'">
    <Content Include="Assets\**\*.png" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="InkMotion.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <PackageReference Include="Microsoft.Graphics.Win2D" Version="1.3.2" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="org.k2fsa.sherpa.onnx" Version="1.13.8" />
    <PackageReference Include="System.Speech" Version="10.0.15" />
  </ItemGroup>

  <PropertyGroup>
    <Vst3HostPlatform Condition="'$(Platform)' == ''">x64</Vst3HostPlatform>
    <Vst3HostPlatform Condition="'$(Platform)' != ''">$(Platform)</Vst3HostPlatform>
    <Vst3HostCMakeArchitecture Condition="'$(Platform)' == 'x86'">Win32</Vst3HostCMakeArchitecture>
    <Vst3HostCMakeArchitecture Condition="'$(Platform)' == 'x64' or '$(Platform)' == ''">x64</Vst3HostCMakeArchitecture>
    <Vst3HostCMakeArchitecture Condition="'$(Platform)' == 'ARM64'">ARM64</Vst3HostCMakeArchitecture>
    <Vst3HostBuildDirectory>$(BaseIntermediateOutputPath)vst3-host\$(Vst3HostPlatform)</Vst3HostBuildDirectory>
    <Vst3HostExecutable>$(Vst3HostBuildDirectory)\$(Configuration)\InkMotionVst3Host.exe</Vst3HostExecutable>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="$(Vst3HostExecutable)"
             Link="Native\$(Vst3HostPlatform)\InkMotionVst3Host.exe"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="BuildVst3HostWorker"
          BeforeTargets="PrepareForBuild"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec Command="cmake -S &quot;$(MSBuildProjectDirectory)\..\..\native\vst3-host&quot; -B &quot;$(Vst3HostBuildDirectory)&quot; -A $(Vst3HostCMakeArchitecture)" />
    <Exec Command="cmake --build &quot;$(Vst3HostBuildDirectory)&quot; --config $(Configuration) --target InkMotionVst3Host --parallel 2" />
  </Target>

  <Target Name="CopyVst3HostWorker" AfterTargets="Build" Condition="'$(DesignTimeBuild)' != 'true'">
    <MakeDir Directories="$(TargetDir)Native\$(Vst3HostPlatform)" />
    <Copy SourceFiles="$(Vst3HostExecutable)"
          DestinationFiles="$(TargetDir)Native\$(Vst3HostPlatform)\InkMotionVst3Host.exe"
          SkipUnchangedFiles="true" />
  </Target>

  <!-- Unpackaged publish omits the app's compiled XAML resources, so the window never loads without this. -->
  <Target Name="PublishAppResourceIndex" AfterTargets="ComputeResolvedFilesToPublishList" Condition="'$(WindowsPackageType)' == 'None'">
    <ItemGroup>
      <ResolvedFileToPublish Include="$(TargetDir)$(TargetName).pri" RelativePath="$(TargetName).pri" CopyToPublishDirectory="PreserveNewest" Condition="Exists('$(TargetDir)$(TargetName).pri')" />
    </ItemGroup>
  </Target>
</Project>
