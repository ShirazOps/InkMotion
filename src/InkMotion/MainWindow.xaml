<Window
    x:Class="InkMotion.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml"
    Title="InkMotion">
    <Grid x:Name="RootGrid" Background="{StaticResource AppBackgroundBrush}" RequestedTheme="Dark">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="26" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Background="{StaticResource ChromeBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,0,0,1" SizeChanged="TitleBar_SizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="10" Padding="14,0,0,0" VerticalAlignment="Center">
                <Image Source="Assets/Square44x44Logo.png" Width="20" Height="20" />
                <TextBlock Text="InkMotion" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                <MenuBar x:Name="AppMenuBar" VerticalAlignment="Center">
                    <MenuBarItem Title="File">
                        <MenuFlyoutItem Text="Open project…" Click="OpenProject_Click">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8E5;" /></MenuFlyoutItem.Icon>
                            <MenuFlyoutItem.KeyboardAccelerators><KeyboardAccelerator Modifiers="Control" Key="O" /></MenuFlyoutItem.KeyboardAccelerators>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Save project" Click="SaveProject_Click">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74E;" /></MenuFlyoutItem.Icon>
                            <MenuFlyoutItem.KeyboardAccelerators><KeyboardAccelerator Modifiers="Control" Key="S" /></MenuFlyoutItem.KeyboardAccelerators>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="Add video clip…" Click="AddVideoClip_Click" />
                        <MenuFlyoutItem Text="Add image…" Click="AddImageClip_Click" />
                        <MenuFlyoutItem Text="Add title" Click="AddTitleClip_Click" />
                        <MenuFlyoutItem Text="Add audio clip…" Click="OpenAudio_Click" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="Export…" Tag="Export" Click="Workspace_Click">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xEDE1;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuBarItem>
                    <MenuBarItem Title="Edit">
                        <MenuFlyoutItem Text="Undo" Click="Undo_Click">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7A7;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Redo" Click="Redo_Click">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7A6;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuBarItem>
                    <MenuBarItem Title="View">
                        <ToggleMenuFlyoutItem x:Name="LayoutOptionsMenu" Text="Show options panel" IsChecked="True" Tag="options" Click="LayoutPanel_Click" />
                        <ToggleMenuFlyoutItem x:Name="LayoutTimelineMenu" Text="Show multitrack / cel timeline" IsChecked="True" Tag="timeline" Click="LayoutPanel_Click" />
                        <ToggleMenuFlyoutItem x:Name="LayoutPreviewMenu" Text="Show video / ink preview" IsChecked="True" Tag="preview" Click="LayoutPanel_Click" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="Expand main editing view" Click="ExpandEditingView_Click" />
                        <MenuFlyoutItem Text="Reset all workspace layouts to default" Click="ResetEditorLayout_Click" />
                    </MenuBarItem>
                </MenuBar>
            </StackPanel>

            <Border x:Name="PageSwitcher" Grid.Column="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="3" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="2">
                    <Button x:Name="VideoWorkspaceButton" Tag="Video" Style="{StaticResource PageButtonStyle}" Click="Workspace_Click" AutomationProperties.Name="Video Editor">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE714;" FontSize="14" />
                            <TextBlock Text="Video Editor" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="AudioWorkspaceButton" Tag="Audio" Style="{StaticResource PageButtonStyle}" Click="Workspace_Click" AutomationProperties.Name="Audio Editor">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8D6;" FontSize="14" />
                            <TextBlock Text="Audio Editor" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="InkWorkspaceButton" Tag="Ink" Style="{StaticResource PageButtonStyle}" Click="Workspace_Click" AutomationProperties.Name="Ink Editor">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xEE56;" FontSize="14" />
                            <TextBlock Text="Ink Editor" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="ExportWorkspaceButton" Tag="Export" Style="{StaticResource PageButtonStyle}" Click="Workspace_Click" AutomationProperties.Name="Export">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xEDE1;" FontSize="14" />
                            <TextBlock Text="Export" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <Grid Grid.Column="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition x:Name="CaptionButtonsColumn" Width="140" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="UnsavedIndicator" Grid.Column="1" Text="● Unsaved changes" FontSize="12" Margin="0,0,12,0" Foreground="{StaticResource WarningTextBrush}" VerticalAlignment="Center" Visibility="Collapsed" />
            </Grid>
        </Grid>

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                      HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled"
                      Background="{StaticResource PanelBrush}">
            <Grid Padding="12,8" MinHeight="48">
                <StackPanel x:Name="VideoActionBar" Orientation="Horizontal" Spacing="8">
                    <Button Content="Add video…" Click="AddVideoClip_Click" />
                    <Button Content="Add image…" Click="AddImageClip_Click" />
                    <Button Content="Add title" Click="AddTitleClip_Click" />
                    <Button Content="Add marker" Click="AddMarker_Click" />
                    <ToggleButton x:Name="VideoSnappingButton" Content="Snap" IsChecked="True" ToolTipService.ToolTip="Snap dragged clip edges within 8 pixels to clip edges, audio edges, markers, the playhead and timeline start" />
                    <UserControl x:Name="ToolbarClipActions" IsEnabled="False">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Trim start" Click="TrimClipStart_Click" />
                            <Button Content="Trim end" Click="TrimClipEnd_Click" />
                            <Button Content="Split" Click="SplitClip_Click" />
                            <Button Content="Duplicate" Click="DuplicateVideoClip_Click" />
                            <Button Content="Ripple delete" Click="RippleDeleteClip_Click" />
                            <Button x:Name="CreateMulticamGroupButton" Content="Group cameras at playhead" Click="CreateMulticamGroup_Click" />
                            <Button x:Name="SwitchMulticamAngleButton" Content="Switch to selected angle" Click="SwitchMulticamAngle_Click" />
                            <Button x:Name="GenerateVideoProxyButton" Content="Generate proxy" Click="GenerateVideoProxy_Click" />
                            <Button x:Name="ToggleVideoProxyButton" Content="Use proxy" Click="ToggleVideoProxy_Click" />
                        </StackPanel>
                    </UserControl>
                    <Button Content="Copy clip" Click="CopyVideoClip_Click" />
                    <Button x:Name="PasteVideoClipButton" Content="Paste at playhead" Click="PasteVideoClip_Click" IsEnabled="False" />
                    <Button x:Name="LinkAudioVideoButton" Content="Link selected audio" Click="LinkSelectedAudioVideo_Click" IsEnabled="False" />
                    <Button x:Name="UnlinkAudioVideoButton" Content="Unlink selected audio" Click="UnlinkSelectedAudioVideo_Click" IsEnabled="False" />
                    <TextBlock Text="Clip and track tools in the inspector →" VerticalAlignment="Center" Style="{StaticResource HintTextStyle}" />
                </StackPanel>
                <StackPanel x:Name="AudioActionBar" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
                    <Button Content="Add audio clip…" Click="OpenAudio_Click" />
                    <Button Content="Add audio track" Click="AddAudioTrack_Click" />
                    <Button Content="Trim start" Click="TrimAudioStart_Click" IsEnabled="{Binding IsEnabled, ElementName=TrimAudioStartButton}" />
                    <Button Content="Trim end" Click="TrimAudioEnd_Click" IsEnabled="{Binding IsEnabled, ElementName=TrimAudioEndButton}" />
                    <Button Content="Split" Click="SplitAudio_Click" IsEnabled="{Binding IsEnabled, ElementName=SplitAudioButton}" />
                    <Button Content="Join next track" Click="JoinAudioClips_Click" IsEnabled="{Binding IsEnabled, ElementName=SplitAudioButton}" />
                    <Button Content="Normalise" Click="NormaliseAudio_Click" IsEnabled="{Binding IsEnabled, ElementName=NormaliseAudioButton}" />
                    <Button Content="Spectrum" Click="AnalyseAudioSpectrum_Click" IsEnabled="{Binding IsEnabled, ElementName=AnalyseAudioSpectrumButton}" />
                    <Button Content="Copy clip" Click="CopyAudioClip_Click" IsEnabled="{Binding IsEnabled, ElementName=SplitAudioButton}" />
                    <Button x:Name="PasteAudioClipButton" Content="Paste at playhead" Click="PasteAudioClip_Click" IsEnabled="False" />
                    <Button Content="Duplicate" Click="DuplicateAudioClip_Click" IsEnabled="{Binding IsEnabled, ElementName=SplitAudioButton}" />
                    <Button x:Name="RemoveAudioClipButton" Content="Remove track" Click="DeleteAudioClip_Click" IsEnabled="False" />
                    <TextBlock Text="Trim, split, mix and tags in the inspector →" VerticalAlignment="Center" Style="{StaticResource HintTextStyle}" />
                </StackPanel>
                <StackPanel x:Name="InkActionBar" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
                    <Button Content="Pen" Click="SelectPen_Click" />
                    <Button Content="Eraser" Click="SelectEraser_Click" />
                    <Button Content="Line" Tag="Line" Click="SelectInkShape_Click" />
                    <Button Content="Rectangle" Tag="Rectangle" Click="SelectInkShape_Click" />
                    <Button Content="Ellipse" Tag="Ellipse" Click="SelectInkShape_Click" />
                    <Button Content="Lasso" Click="SelectInkLasso_Click" />
                    <Button Content="Add cel" Click="AddFrame_Click" />
                    <Button Content="Duplicate cel" Click="DuplicateFrame_Click" />
                    <Button Content="Copy cel" Click="CopyCel_Click" />
                    <Button x:Name="PasteCelButton" Content="Paste cel" Click="PasteCel_Click" IsEnabled="False" />
                    <Button Content="Add ink layer" Click="AddInkLayer_Click" />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button Content="Lower layer" Tag="-1" Click="MoveInkLayer_Click" ToolTipService.ToolTip="Move the layer earlier in the bottom-to-top rendering order" />
                        <Button Content="Raise layer" Tag="1" Click="MoveInkLayer_Click" ToolTipService.ToolTip="Move the layer later in the bottom-to-top rendering order" />
                    </StackPanel>
                    <TextBlock Text="Brushes, text and animation in the inspector →" VerticalAlignment="Center" Style="{StaticResource HintTextStyle}" />
                </StackPanel>
                <StackPanel x:Name="ExportActionBar" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
                    <Button x:Name="ToolbarExportButton" Content="Export video…" Click="ExportVideo_Click" Style="{StaticResource AccentButtonStyle}" />
                    <TextBlock Text="Output settings and progress in the inspector →" VerticalAlignment="Center" Style="{StaticResource HintTextStyle}" />
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <Grid x:Name="EditorLayoutGrid" Grid.Row="2" Padding="8" SizeChanged="EditorLayout_SizeChanged">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="EditorPreviewRow" Height="3*" />
                <RowDefinition x:Name="EditorDividerRow" Height="10" />
                <RowDefinition x:Name="EditorTimelineRow" Height="2*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="EditorDividerColumn" Width="10" />
                <ColumnDefinition x:Name="EditorOptionsColumn" Width="340" />
            </Grid.ColumnDefinitions>

            <Grid x:Name="EditorPreviewPanel" Grid.Row="0" Grid.Column="0" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="48" />
                </Grid.RowDefinitions>

                <Grid x:Name="EditorPreviewHeader" Style="{StaticResource PanelStyle}" Padding="12,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="PreviewCaption" Text="MODIFIED" VerticalAlignment="Center" FontSize="10" CharacterSpacing="100" Foreground="{StaticResource TextMutedBrush}" />
                    <ToggleSwitch x:Name="OriginalPreviewToggle" Grid.Column="1" OffContent="Modified" OnContent="Original"
                                  Toggled="OriginalPreview_Toggled" AutomationProperties.Name="Preview original source"
                                  ToolTipService.ToolTip="Compare the active video source at the timeline position, without clip volume, mute, opacity, overlays or added audio. Switching pauses playback. This does not change the export." />
                </Grid>

                <Grid x:Name="PreviewViewport" Grid.Row="1" SizeChanged="PreviewViewport_SizeChanged"
                      Background="{StaticResource StageBrush}">
                <Grid x:Name="PreviewStage" Style="{StaticResource PanelStyle}" Background="{StaticResource StageBrush}" RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <CompositeTransform x:Name="PreviewCanvasTransform" />
                    </Grid.RenderTransform>
                    <Grid Margin="12">
                        <MediaPlayerElement x:Name="PreviewPlayer" AreTransportControlsEnabled="False" Stretch="Uniform" />
                        <canvas:CanvasControl
                            x:Name="CompositionSurface"
                            ClearColor="Transparent"
                            IsHitTestVisible="False"
                            CreateResources="CompositionSurface_CreateResources"
                            Draw="CompositionSurface_Draw" />
                        <canvas:CanvasControl
                            x:Name="InkSurface"
                            ClearColor="Transparent"
                            Draw="InkSurface_Draw"
                            PointerPressed="InkSurface_PointerPressed"
                            PointerMoved="InkSurface_PointerMoved"
                            PointerReleased="InkSurface_PointerReleased"
                            PointerCaptureLost="InkSurface_PointerCaptureLost"
                            SizeChanged="InkSurface_SizeChanged"
                            Visibility="Collapsed" />
                        <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" IsHitTestVisible="False">
                            <TextBlock x:Name="EmptyPreviewHeading" Text="Your canvas is ready" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock x:Name="EmptyPreviewHint" Text="Add a video, image or title, then draw in Ink Editor." HorizontalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Grid>
                    </Grid>
                </Grid>

                <Grid x:Name="TransportBar" Grid.Row="2" Style="{StaticResource PanelStyle}" Padding="10,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="FrameReadout" Text="F 001 · C001" VerticalAlignment="Center" FontFamily="Consolas" FontSize="15" Foreground="{StaticResource TextPrimaryBrush}" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                        <Button Style="{StaticResource TransportButtonStyle}" Click="PreviousFrame_Click" ToolTipService.ToolTip="Previous frame" AutomationProperties.Name="Previous frame">
                            <FontIcon Glyph="&#xE892;" FontSize="14" />
                        </Button>
                        <Button x:Name="PlayButton" Width="52" Height="34" Padding="0" CornerRadius="17" Style="{StaticResource AccentButtonStyle}" Click="Play_Click" ToolTipService.ToolTip="Play" AutomationProperties.Name="Play">
                            <FontIcon x:Name="PlayButtonIcon" Glyph="&#xE768;" FontSize="14" />
                        </Button>
                        <Button Style="{StaticResource TransportButtonStyle}" Click="NextFrame_Click" ToolTipService.ToolTip="Next frame" AutomationProperties.Name="Next frame">
                            <FontIcon Glyph="&#xE893;" FontSize="14" />
                        </Button>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
                        <Button x:Name="UndoButton" Style="{StaticResource TransportButtonStyle}" Click="Undo_Click" IsEnabled="False" ToolTipService.ToolTip="Undo" AutomationProperties.Name="Undo">
                            <FontIcon Glyph="&#xE7A7;" FontSize="14" />
                        </Button>
                        <Button x:Name="RedoButton" Style="{StaticResource TransportButtonStyle}" Click="Redo_Click" IsEnabled="False" ToolTipService.ToolTip="Redo" AutomationProperties.Name="Redo">
                            <FontIcon Glyph="&#xE7A6;" FontSize="14" />
                        </Button>
                    </StackPanel>
                </Grid>

            </Grid>

            <Grid x:Name="VideoInspectorPanel" Grid.Row="0" Grid.Column="2" Style="{StaticResource PanelStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Padding="18" Spacing="14">
                        <TextBlock Text="Video Editor" Style="{StaticResource PanelTitleTextStyle}" />
                        <TextBlock Text="VIDEO SCOPES" Style="{StaticResource SectionHeaderTextStyle}" />
                        <canvas:CanvasControl x:Name="VideoRgbHistogramSurface" Height="130" MinHeight="110"
                            Draw="VideoRgbHistogram_Draw"
                            AutomationProperties.Name="RGB histogram for the active video source after clip colour grading" />
                        <TextBlock Text="RGB HISTOGRAM" Style="{StaticResource SectionHeaderTextStyle}" />
                        <TextBlock x:Name="VideoScopeStatus" Text="Switch to Modified preview to view the active clip's RGB distribution."
                            TextWrapping="Wrap" Style="{StaticResource HintTextStyle}" />
                        <TextBlock Text="Horizontal: channel value (0-255) · vertical: square-root-scaled pixel frequency."
                            TextWrapping="Wrap" Style="{StaticResource HintTextStyle}" />
                        <TextBlock Text="LUMA WAVEFORM" Style="{StaticResource SectionHeaderTextStyle}" />
                        <canvas:CanvasControl x:Name="VideoLumaWaveformSurface" Height="130" MinHeight="110"
                            Draw="VideoLumaWaveform_Draw"
                            AutomationProperties.Name="Luma waveform for the active video source after clip colour grading; horizontal is image position and vertical is luma from black to white" />
                        <TextBlock x:Name="VideoLumaWaveformStatus" Text="Switch to Modified preview to view the active clip's luma waveform."
                            TextWrapping="Wrap" Style="{StaticResource HintTextStyle}" />
                        <TextBlock Text="Horizontal: source image position · vertical: luma (black at bottom, white at top) · brightness: pixel density."
                            TextWrapping="Wrap" Style="{StaticResource HintTextStyle}" />
                        <TextBlock Text="VECTORSCOPE" Style="{StaticResource SectionHeaderTextStyle}" />
                        <canvas:CanvasControl x:Name="VideoVectorscopeSurface" Height="150" MinHeight="130"
                            Draw="VideoVectorscope_Draw"
                            AutomationProperties.Name="Vectorscope for the active video source after clip colour grading, using Rec. 709 Cb and Cr chroma axes" />
                        <TextBlock x:Name="VideoVectorscopeStatus" Text="Switch to Modified preview to view the active clip's chroma distribution."
                            TextWrapping="Wrap" Style="{StaticResource HintTextStyle}" />
                        <TextBlock Text="Rec. 709 Cb/Cr chroma: neutral at centre, greater saturation farther from centre; pixel brightness shows density."
                            TextWrapping="Wrap" Style="{StaticResource HintTextStyle}" />
                        <TextBlock Text="Active video source after clip colour grading; crop, transform, opacity, cross-dissolves and overlays are excluded."
                            TextWrapping="Wrap" Style="{StaticResource HintTextStyle}" />
                        <TextBlock Text="TIMELINE MARKERS" Style="{StaticResource SectionHeaderTextStyle}" />
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Button Content="Add" Click="AddMarker_Click" />
                            <Button Content="Previous" Tag="previous" Click="MarkerAction_Click" />
                            <Button Content="Next" Tag="next" Click="MarkerAction_Click" />
                        </StackPanel>
                        <ComboBox x:Name="MarkerSelector" Header="Named markers" HorizontalAlignment="Stretch" SelectionChanged="Marker_SelectionChanged" />
                        <TextBox x:Name="MarkerNameBox" Header="Marker name" MaxLength="200" />
                        <UserControl x:Name="MarkerActions" IsEnabled="False">
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Button Content="Go to" Tag="jump" Click="MarkerAction_Click" />
                                    <Button Content="Rename" Tag="rename" Click="MarkerAction_Click" />
                                    <Button Content="Delete" Tag="delete" Click="MarkerAction_Click" />
                                </StackPanel>
                                <Button Content="Move marker to playhead" Tag="move" Click="MarkerAction_Click" />
                            </StackPanel>
                        </UserControl>
                        <TextBlock Text="Markers are project guides, not exported overlays. Clip dragging snaps to them; frame-rate changes preserve their time to the nearest frame." TextWrapping="Wrap" Style="{StaticResource HintTextStyle}" />
                        <Border Style="{StaticResource DividerStyle}" />
                        <TextBlock Text="PROJECT SETTINGS" Style="{StaticResource SectionHeaderTextStyle}" />
                        <TextBlock Text="Frame rate" Style="{StaticResource LabelTextStyle}" />
                        <ComboBox x:Name="FrameRateSelector" SelectedIndex="1" SelectionChanged="FrameRate_SelectionChanged">
                            <ComboBoxItem Content="12 fps" Tag="12" />
                            <ComboBoxItem Content="24 fps" Tag="24" />
                            <ComboBoxItem Content="30 fps" Tag="30" />
                            <ComboBoxItem Content="60 fps" Tag="60" />
                        </ComboBox>
                        <Border Style="{StaticResource DividerStyle}" />
                        <TextBlock Text="SOURCE MONITOR" Style="{StaticResource SectionHeaderTextStyle}" />
                        <Button Content="Load source video..." Click="LoadSourceMonitor_Click" />
                        <MediaPlayerElement x:Name="SourceMonitorPlayer" AreTransportControlsEnabled="True"
                                            AutoPlay="False" Height="180" HorizontalAlignment="Stretch" />
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Button x:Name="SourceMonitorMarkInButton" Content="Mark In" Tag="in"
                                    Click="SourceMonitorMark_Click" IsEnabled="False" />
                            <Button x:Name="SourceMonitorMarkOutButton" Content="Mark Out" Tag="out"
                                    Click="SourceMonitorMark_Click" IsEnabled="False" />
                            <Button x:Name="ClearSourceMonitorMarksButton" Content="Clear marks"
                                    Click="ClearSourceMonitorMarks_Click" IsEnabled="False" />
                        </StackPanel>
                        <TextBlock x:Name="SourceMonitorMarksText" Text="In: not set   Out: not set"
                                   Style="{StaticResource LabelTextStyle}" />
                        <Button x:Name="AddMarkedVideoClipButton" Content="Add marked range on a free track"
                                Click="AddMarkedVideoClip_Click" IsEnabled="False" />
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Button x:Name="InsertMarkedVideoClipButton" Content="Insert on selected video track"
                                    Click="InsertMarkedVideoClip_Click" IsEnabled="False"
                                    ToolTipService.ToolTip="Insert the marked source range and shift later clips on the selected video track" />
                            <Button x:Name="OverwriteMarkedVideoClipButton" Content="Overwrite on selected video track"
                                    Click="OverwriteMarkedVideoClip_Click" IsEnabled="False"
                                    ToolTipService.ToolTip="Replace the marked-duration interval on the selected video track without shifting downstream clips" />
                        </StackPanel>
                        <TextBlock x:Name="SourceMonitorStatus" Text="Load a video, preview it, then mark its source range."
                                   TextWrapping="Wrap" Style="{StaticResource HintTextStyle}" />
                        <TextBlock Text="Mark In and Out from the source player's current position; the marked range becomes a new video clip at the timeline playhead. Marks are not project data and remain available for another insert until cleared or a new source is loaded. The original source file is not changed." TextWrapping="Wrap" Style="{StaticResource HintTextStyle}" />
                        <TextBlock Text="ADD AT PLAYHEAD" Style="{StaticResource SectionHeaderTextStyle}" />
                        <Grid ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Content="Video" HorizontalAlignment="Stretch" Click="AddVideoClip_Click" ToolTipService.ToolTip="Add a video clip" />
                            <Button Grid.Column="1" Content="Image" HorizontalAlignment="Stretch" Click="AddImageClip_Click" ToolTipService.ToolTip="Add a still image" />
                            <Button Grid.Column="2" Content="Title" HorizontalAlignment="Stretch" Click="AddTitleClip_Click" ToolTipService.ToolTip="Add a text title" />
                        </Grid>
                        <Border Style="{StaticResource DividerStyle}" />
                        <TextBlock Text="TRACK" Style="{StaticResource SectionHeaderTextStyle}" />
                        <TextBox x:Name="TimelineTrackNameBox" Header="Name" MaxLength="64" LostFocus="TimelineTrackName_LostFocus" KeyDown="TimelineTrackName_KeyDown" />
                        <Grid ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <DropDownButton Content="Add track" HorizontalAlignment="Stretch">
                                <DropDownButton.Flyout>
                                    <MenuFlyout Placement="Bottom">
                                        <MenuFlyoutItem Text="Video track" Tag="Video" Click="AddTimelineTrack_Click" />
                                        <MenuFlyoutItem Text="Image track" Tag="Image" Click="AddTimelineTrack_Click" />
                                        <MenuFlyoutItem Text="Title track" Tag="Text" Click="AddTimelineTrack_Click" />
                                    </MenuFlyout>
                                </DropDownButton.Flyout>
                            </DropDownButton>
                            <Button x:Name="MoveTrackUpButton" Grid.Column="1" Tag="-1" Click="MoveTimelineTrack_Click" ToolTipService.ToolTip="Move track up" AutomationProperties.Name="Move track up">
                                <FontIcon Glyph="&#xE70E;" FontSize="12" />
                            </Button>
                            <Button x:Name="MoveTrackDownButton" Grid.Column="2" Tag="1" Click="MoveTimelineTrack_Click" ToolTipService.ToolTip="Move track down" AutomationProperties.Name="Move track down">
                                <FontIcon Glyph="&#xE70D;" FontSize="12" />
                            </Button>
                            <Button x:Name="DeleteTrackButton" Grid.Column="3" Click="DeleteTimelineTrack_Click" ToolTipService.ToolTip="Delete track" AutomationProperties.Name="Delete track">
                                <FontIcon Glyph="&#xE74D;" FontSize="12" />
                            </Button>
                        </Grid>
                        <Border Style="{StaticResource DividerStyle}" />
                        <TextBlock Text="CLIP" Style="{StaticResource SectionHeaderTextStyle}" />
                        <TextBlock x:Name="SelectedClipLabel" Text="No clip selected" TextWrapping="Wrap" Style="{StaticResource LabelTextStyle}" />
                        <Grid x:Name="ClipActionsGrid" ColumnSpacing="6" RowSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Button Content="Trim start" HorizontalAlignment="Stretch" Click="TrimClipStart_Click" ToolTipService.ToolTip="Remove the part of the clip before the playhead" />
                            <Button Grid.Column="1" Content="Trim end" HorizontalAlignment="Stretch" Click="TrimClipEnd_Click" ToolTipService.ToolTip="Remove the part of the clip after the playhead" />
                            <Button Grid.Row="1" Content="Split" HorizontalAlignment="Stretch" Click="SplitClip_Click" ToolTipService.ToolTip="Cut the clip at the playhead" />
                            <Button Grid.Row="1" Grid.Column="1" Content="Move to playhead" HorizontalAlignment="Stretch" Click="MoveClipToPlayhead_Click" />
                            <Button Grid.Row="2" Content="Delete" HorizontalAlignment="Stretch" Click="DeleteClip_Click" />
                            <Button Grid.Row="2" Grid.Column="1" Content="Ripple delete" HorizontalAlignment="Stretch" Click="RippleDeleteClip_Click" ToolTipService.ToolTip="Delete the clip and close the gap" />
                        </Grid>
                        <StackPanel x:Name="ClipPropertiesPanel" Spacing="10">
                            <Button Content="Close gap before clip" Click="CloseGapBeforeClip_Click"
                                    ToolTipService.ToolTip="Shift this clip and all later clips on this track towards the preceding clip, or frame 1. Removes whole-frame space only; other tracks, audio, markers and ink are not moved." />
                            <Button x:Name="RelinkTimelineClipButton" Content="Relink source..." Click="RelinkTimelineClip_Click" />
                            <Button x:Name="RelinkMatchingSourcesButton" Content="Relink all matching sources..." Tag="batch" Click="RelinkTimelineClip_Click"
                                    ToolTipService.ToolTip="Replace all uses of this source on video or image tracks of the same kind. Any locked matching track or insufficient source length rejects the entire operation. Undo restores all source links." />
                            <TextBlock x:Name="ClipSourceRangeText" TextWrapping="Wrap" Style="{StaticResource HintTextStyle}" />
                            <StackPanel x:Name="VideoSlipActions" Spacing="6">
                              <NumberBox x:Name="VideoSourceInBox" Header="Source in (seconds)" Minimum="0" SmallChange="0.1" SpinButtonPlacementMode="Compact" />
                              <NumberBox x:Name="VideoSourceOutBox" Header="Source out (seconds)" Minimum="0" SmallChange="0.1" SpinButtonPlacementMode="Compact" />
                              <Button Content="Apply source range" Click="ApplyVideoSourceRange_Click" />
                              <TextBlock Text="Applies both source endpoints together at the current timeline start. Duration may change, but neighbouring clips are not moved. Source handles, one-frame minimum duration, fades and overlaps are checked before applying. Undo restores the previous range." TextWrapping="Wrap" Style="{StaticResource HintTextStyle}" />
                              <Button Content="Join next video clip" Click="JoinVideoClip_Click"
                                      ToolTipService.ToolTip="Join adjacent consecutive sections of the same source with matching properties and no fade at the cut" />
                              <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Content="Slip source -1" Tag="-1" Click="SlipVideoClip_Click" ToolTipService.ToolTip="Move the source range one project frame earlier without moving the clip" />
                                <Button Content="Slip source +1" Tag="1" Click="SlipVideoClip_Click" ToolTipService.ToolTip="Move the source range one project frame later without moving the clip" />
                              </StackPanel>
                              <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Content="Roll end -1" Tag="-1" Click="RollVideoClip_Click" ToolTipService.ToolTip="Move the cut to the next adjacent clip one project frame earlier" />
                                <Button Content="Roll end +1" Tag="1" Click="RollVideoClip_Click" ToolTipService.ToolTip="Move the cut to the next adjacent clip one project frame later" />
                              </StackPanel>
                              <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Content="Slide clip -1" Tag="-1" Click="SlideVideoClip_Click" ToolTipService.ToolTip="Move this clip one project frame earlier, trimming its neighbours to preserve the sequence length" />
                                <Button Content="Slide clip +1" Tag="1" Click="SlideVideoClip_Click" ToolTipService.ToolTip="Move this clip one project frame later, trimming its neighbours to preserve the sequence length" />
                              </StackPanel>
                              <TextBlock Text="Roll moves the cut to the next clip; slide trims both neighbours. Clips must touch on this video track, with unused source handles. Sequence length and fade values are preserved; operations that would consume a clip or invalidate fades are rejected." TextWrapping="Wrap" Style="{StaticResource HintTextStyle}" />
                              <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Content="Ripple end -1" Tag="-1" Click="RippleTrimVideoClip_Click"
                                        ToolTipService.ToolTip="Shorten this clip by one project frame and shift later clips on this track earlier" />
                                <Button Content="Ripple end +1" Tag="1" Click="RippleTrimVideoClip_Click"
                                        ToolTipService.ToolTip="Extend this clip by one project frame and shift later clips on this track later" />
                              </StackPanel>
                              <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Content="Ripple start -1" Tag="-1" Click="RippleTrimVideoStart_Click"
                                        ToolTipService.ToolTip="Include one earlier source frame at this clip's fixed start and shift later clips on this track later" />
                                <Button Content="Ripple start +1" Tag="1" Click="RippleTrimVideoStart_Click"
                                        ToolTipService.ToolTip="Remove one source frame from this clip's fixed start and shift later clips on this track earlier" />
                              </StackPanel>
                              <TextBlock Text="Ripple changes sequence length and shifts all later clips on this track, keeping gaps. Ripple start keeps this clip's timeline start fixed; +1 removes a source frame, -1 includes an earlier one. Other tracks, added audio, markers and ink are not linked or moved." TextWrapping="Wrap" Style="{StaticResource HintTextStyle}" />
                            </StackPanel>
                            <Slider x:Name="ClipOpacitySlider" Header="Opacity" Minimum="0" Maximum="1" StepFrequency="0.01" ValueChanged="ClipProperty_Changed" LostFocus="ClipProperty_LostFocus" />
                            <Slider x:Name="ClipVolumeSlider" Header="Clip volume" Minimum="0" Maximum="1" StepFrequency="0.01" ValueChanged="ClipProperty_Changed" LostFocus="ClipProperty_LostFocus" />
                            <NumberBox x:Name="ClipPlaybackSpeedBox" Header="Playback speed (0.25x–4x)" Minimum="0.25" Maximum="4" SmallChange="0.25" SpinButtonPlacementMode="Compact" ValueChanged="ClipPlaybackSpeed_Changed" />
                            <CheckBox x:Name="ClipReverseVideoCheck" Content="Reverse video" Click="ClipPlaybackOption_Click" />
                            <CheckBox x:Name="ClipReverseAudioCheck" Content="Reverse embedded audio (when reversed)" Click="ClipPlaybackOption_Click" />
                            <TextBlock x:Name="ClipPlaybackHintText" Text="Reverse audio is included in exports when enabled; embedded audio is muted during reverse preview." TextWrapping="Wrap" Style="{StaticResource HintTextStyle}" />
                            <Grid ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <NumberBox x:Name="ClipFadeInBox" Header="Fade in (s)" Minimum="0" Maximum="3600" SmallChange="0.25" SpinButtonPlacementMode="Compact" ValueChanged="ClipNumber_Changed" />
                                <NumberBox x:Name="ClipFadeOutBox" Grid.Column="1" Header="Fade out (s)" Minimum="0" Maximum="3600" SmallChange="0.25" SpinButtonPlacementMode="Compact" ValueChanged="ClipNumber_Changed" />
                            </Grid>
                            <StackPanel x:Name="VideoTransitionActions" Spacing="6">
                                <NumberBox x:Name="CrossDissolveDurationBox" Header="Cross-dissolve duration (s)" Minimum="0.084" Maximum="30" Value="1" SmallChange="0.25" SpinButtonPlacementMode="Compact" />
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Button Content="Apply cross-dissolve" Click="ApplyCrossDissolve_Click" />
                                    <Button Content="Remove transition" Click="RemoveCrossDissolve_Click" />
                                </StackPanel>
                                <TextBlock Text="Transitions span the cut without moving either clip. Both sources need unused footage before/after their selected ranges; transition opacity requires both clip opacities at 100%. This is a video-only dissolve; audio timing and volume are unchanged." TextWrapping="Wrap" Style="{StaticResource HintTextStyle}" />
                            </StackPanel>
                            <StackPanel x:Name="TransformKeyframeActions" Spacing="6">
                                <TextBlock x:Name="TransformKeyframeStateText" TextWrapping="Wrap" Style="{StaticResource HintTextStyle}" />
                                <Button x:Name="StabiliseVideoButton" Content="Analyse and stabilise video" Click="StabiliseVideo_Click" />
                                <TextBlock Text="Translation-only stabilisation estimates frame motion and smooths the path; it may crop by up to 25%. Existing transform keyframes are replaced." TextWrapping="Wrap" Style="{StaticResource HintTextStyle}" />
                                <Button x:Name="SetMaskKeyframeButton" Content="Add/update mask tracking keyframe" Click="SetMaskKeyframe_Click" />
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Button x:Name="SetTransformKeyframeButton" Content="Add/update keyframe" Click="SetTransformKeyframe_Click" />
                                    <Button x:Name="RemoveTransformKeyframeButton" Content="Remove keyframe" Click="RemoveTransformKeyframe_Click" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Button x:Name="PreviousTransformKeyframeButton" Content="Previous keyframe" Click="NavigateTransformKeyframe_Click" Tag="previous" />
                                    <Button x:Name="NextTransformKeyframeButton" Content="Next keyframe" Click="NavigateTransformKeyframe_Click" Tag="next" />
                                </StackPanel>
                                <TextBlock Text="Transform keyframes interpolate linearly. Once enabled, changing position, scale or rotation creates or updates a keyframe at the playhead." TextWrapping="Wrap" Style="{StaticResource HintTextStyle}" />
                            </StackPanel>
                            <TextBlock x:Name="ClipCropLabel" Text="Crop each source edge by a percentage. Crop is non-destructive and stays with the clip." TextWrapping="Wrap" Style="{StaticResource HintTextStyle}" />
                            <Grid x:Name="ClipCropGrid" ColumnSpacing="6" RowSpacing="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <NumberBox x:Name="ClipCropLeftBox" Header="Crop left (%)" Minimum="0" Maximum="49" SmallChange="1" SpinButtonPlacementMode="Compact" ValueChanged="ClipCrop_Changed" />
                                <NumberBox x:Name="ClipCropRightBox" Grid.Column="1" Header="Crop right (%)" Minimum="0" Maximum="49" SmallChange="1" SpinButtonPlacementMode="Compact" ValueChanged="ClipCrop_Changed" />
                                <NumberBox x:Name="ClipCropTopBox" Grid.Row="1" Header="Crop top (%)" Minimum="0" Maximum="49" SmallChange="1" SpinButtonPlacementMode="Compact" ValueChanged="ClipCrop_Changed" />
                                <NumberBox x:Name="ClipCropBottomBox" Grid.Row="1" Grid.Column="1" Header="Crop bottom (%)" Minimum="0" Maximum="49" SmallChange="1" ValueChanged="ClipCrop_Changed" />
                            </Grid>
                            <StackPanel x:Name="ClipColourGradingControls" Spacing="6">
                                <TextBlock Text="COLOUR" Style="{StaticResource SectionHeaderTextStyle}" />
                                <Grid ColumnSpacing="6" RowSpacing="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <NumberBox x:Name="ClipExposureBox" Header="Exposure (EV)" Minimum="-2" Maximum="2" Value="0" SmallChange="0.1" SpinButtonPlacementMode="Compact" ValueChanged="ClipColourGrading_Changed" LostFocus="ClipProperty_LostFocus" />
                                    <NumberBox x:Name="ClipContrastBox" Grid.Column="1" Header="Contrast (-1 to +1)" Minimum="-1" Maximum="1" Value="0" SmallChange="0.05" SpinButtonPlacementMode="Compact" ValueChanged="ClipColourGrading_Changed" LostFocus="ClipProperty_LostFocus" />
                                    <NumberBox x:Name="ClipWhiteBalanceTemperatureBox" Grid.Row="1" Header="Temperature (-1 cool, +1 warm)" Minimum="-1" Maximum="1" Value="0" SmallChange="0.05" SpinButtonPlacementMode="Compact" ValueChanged="ClipColourGrading_Changed" LostFocus="ClipProperty_LostFocus" />
                                    <NumberBox x:Name="ClipWhiteBalanceTintBox" Grid.Row="1" Grid.Column="1" Header="Tint (-1 green, +1 magenta)" Minimum="-1" Maximum="1" Value="0" SmallChange="0.05" SpinButtonPlacementMode="Compact" ValueChanged="ClipColourGrading_Changed" LostFocus="ClipProperty_LostFocus" />
                                    <NumberBox x:Name="ClipSaturationBox" Grid.Row="2" Header="Saturation" Minimum="0" Maximum="2" Value="1" SmallChange="0.05" SpinButtonPlacementMode="Compact" ValueChanged="ClipColourGrading_Changed" LostFocus="ClipProperty_LostFocus" />
                                </Grid>
                                <TextBlock Text="Colour changes apply to the video or image clip in live preview and export. Neutral values are Exposure 0 EV, Contrast 0, Temperature/Tint 0 and Saturation 1." TextWrapping="Wrap" Style="{StaticResource HintTextStyle}" />
                                <ComboBox x:Name="ClipCurveChannelSelector" Header="Curve channel" SelectedIndex="0" SelectionChanged="ClipCurveChannel_Changed">
                                    <ComboBoxItem Content="Master" Tag="Master" />
                                    <ComboBoxItem Content="Red" Tag="Red" />
                                    <ComboBoxItem Content="Green" Tag="Green" />
                                    <ComboBoxItem Content="Blue" Tag="Blue" />
                                </ComboBox>
                                <canvas:CanvasControl x:Name="ClipCurveCanvas" Height="180" MinHeight="180"
                                                      Draw="ClipCurveCanvas_Draw"
                                                      PointerPressed="ClipCurveCanvas_PointerPressed"
                                                      PointerMoved="ClipCurveCanvas_PointerMoved"
                                                      PointerReleased="ClipCurveCanvas_PointerReleased"
                                                      PointerCaptureLost="ClipCurveCanvas_PointerCaptureLost" />
                                <Button Content="Reset selected curve" Click="ResetClipCurve_Click" />
                                <TextBlock Text="Click the graph to add a point, drag points to shape the curve, or right-click a point to remove it. Endpoints stay fixed." TextWrapping="Wrap" Style="{StaticResource HintTextStyle}" />
                                <TextBlock x:Name="ClipColourLutLabel" Text="No 3D LUT selected" TextWrapping="Wrap" Style="{StaticResource HintTextStyle}" />
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Button Content="Load 3D LUT (.cube)..." Click="LoadClipColourLut_Click" />
                                    <Button x:Name="RemoveClipColourLutButton" Content="Remove LUT" Click="RemoveClipColourLut_Click" />
                                </StackPanel>
                                <TextBlock Text="CHROMA KEY" Style="{StaticResource SectionHeaderTextStyle}" />
                                <ToggleButton x:Name="ClipChromaKeyEnabled" Content="Remove key colour" Click="ClipChromaKey_Changed" />
                                <ComboBox x:Name="ClipChromaKeyColourSelector" Header="Key colour" SelectionChanged="ClipChromaKeyColour_Changed">
                                    <ComboBoxItem Content="Green screen" Tag="FF00FF00" />
                                    <ComboBoxItem Content="Blue screen" Tag="FF0000FF" />
                                    <ComboBoxItem Content="Magenta screen" Tag="FFFF00FF" />
                                </ComboBox>
                                <NumberBox x:Name="ClipChromaKeyToleranceBox" Header="Colour tolerance (0-1)" Minimum="0" Maximum="1" Value="0.1" SmallChange="0.01" SpinButtonPlacementMode="Compact" ValueChanged="ClipChromaKeyTolerance_Changed" LostFocus="ClipProperty_LostFocus" />
                                <ToggleButton x:Name="ClipChromaKeyFeather" Content="Soften key edges" IsChecked="True" Click="ClipChromaKey_Changed" />
                                <TextBlock Text="Removes the selected key colour to transparency before compositing. Feather softens the transition edge; this is a basic colour key, not spill suppression or a tracked matte." TextWrapping="Wrap" Style="{StaticResource HintTextStyle}" />
                                <TextBlock Text="BLUR" Style="{StaticResource SectionHeaderTextStyle}" />
                                <NumberBox x:Name="ClipBlurAmountBox" Header="Gaussian blur (0-20)" Minimum="0" Maximum="20" Value="0" SmallChange="0.25" SpinButtonPlacementMode="Compact" ValueChanged="ClipBlurAmount_Changed" LostFocus="ClipProperty_LostFocus" />
                                <TextBlock Text="Softens the video or image source before it is composited. Zero leaves the source unchanged." TextWrapping="Wrap" Style="{StaticResource HintTextStyle}" />
                                <NumberBox x:Name="ClipSharpenAmountBox" Header="Sharpen (0-10)" Minimum="0" Maximum="10" Value="0" SmallChange="0.25" SpinButtonPlacementMode="Compact" ValueChanged="ClipSharpenAmount_Changed" LostFocus="ClipProperty_LostFocus" />
                                <TextBlock Text="Enhances source edges before compositing. Use modest values to avoid accentuating compression noise." TextWrapping="Wrap" Style="{StaticResource HintTextStyle}" />
                                <NumberBox x:Name="ClipVignetteAmountBox" Header="Vignette (0-1)" Minimum="0" Maximum="1" Value="0" SmallChange="0.05" SpinButtonPlacementMode="Compact" ValueChanged="ClipVignetteAmount_Changed" LostFocus="ClipProperty_LostFocus" />
                                <TextBlock Text="Darkens the edges of the video or image source. Zero leaves the source unchanged." TextWrapping="Wrap" Style="{StaticResource HintTextStyle}" />
                                <TextBlock Text="MASK" Style="{StaticResource SectionHeaderTextStyle}" />
                                <ComboBox x:Name="ClipMaskShapeSelector" Header="Mask shape" SelectedIndex="0" SelectionChanged="ClipMaskShape_Changed">
                                    <ComboBoxItem Content="None" Tag="None" />
                                    <ComboBoxItem Content="Rectangle" Tag="Rectangle" />
                                    <ComboBoxItem Content="Ellipse" Tag="Ellipse" />
                                </ComboBox>
                                <ToggleButton x:Name="ClipMaskInvertedCheck" Content="Invert mask" Click="ClipMaskSettings_Changed" />
                                <NumberBox x:Name="ClipMaskFeatherBox" Header="Mask feather (0-0.25 frame)" Minimum="0" Maximum="0.25" Value="0" SmallChange="0.01" SpinButtonPlacementMode="Compact" ValueChanged="ClipMaskFeather_Changed" LostFocus="ClipProperty_LostFocus" />
                                <Button x:Name="TrackMaskSubjectButton" Content="Track mask from playhead" Click="TrackMaskSubject_Click" />
                                <Grid ColumnSpacing="6" RowSpacing="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <NumberBox x:Name="ClipMaskXBox" Header="Centre X (0-1)" Minimum="0" Maximum="1" Value="0.5" SmallChange="0.01" SpinButtonPlacementMode="Compact" ValueChanged="ClipMaskNumber_Changed" />
                                    <NumberBox x:Name="ClipMaskYBox" Grid.Column="1" Header="Centre Y (0-1)" Minimum="0" Maximum="1" Value="0.5" SmallChange="0.01" SpinButtonPlacementMode="Compact" ValueChanged="ClipMaskNumber_Changed" />
                                    <NumberBox x:Name="ClipMaskWidthBox" Grid.Row="1" Header="Width (0-1)" Minimum="0.01" Maximum="1" Value="1" SmallChange="0.01" SpinButtonPlacementMode="Compact" ValueChanged="ClipMaskNumber_Changed" />
                                    <NumberBox x:Name="ClipMaskHeightBox" Grid.Row="1" Grid.Column="1" Header="Height (0-1)" Minimum="0.01" Maximum="1" Value="1" SmallChange="0.01" SpinButtonPlacementMode="Compact" ValueChanged="ClipMaskNumber_Changed" />
                                </Grid>
                                <TextBlock Text="Hard-edged rectangle/ellipse masks composite with other layers. On video clips, add mask keyframes at selected playhead positions to animate the mask manually; automatic subject tracking and feathered/inverted masks are not included." TextWrapping="Wrap" Style="{StaticResource HintTextStyle}" />
                            </StackPanel>
                            <NumberBox x:Name="ClipDurationBox" Header="Duration (s)" Minimum="0.04" Maximum="3600" SmallChange="0.5" SpinButtonPlacementMode="Compact" ValueChanged="ClipNumber_Changed" />
                            <TextBox x:Name="ClipTextBox" Header="Title text" AcceptsReturn="True" TextWrapping="Wrap" MaxLength="500" TextChanged="ClipText_Changed" LostFocus="ClipProperty_LostFocus" />
                            <ComboBox x:Name="ClipFontSelector" Header="Font" HorizontalAlignment="Stretch" SelectionChanged="ClipChoice_Changed">
                                <ComboBoxItem Content="Segoe UI" Tag="Segoe UI" />
                                <ComboBoxItem Content="Segoe Print" Tag="Segoe Print" />
                                <ComboBoxItem Content="Segoe Script" Tag="Segoe Script" />
                                <ComboBoxItem Content="Georgia" Tag="Georgia" />
                                <ComboBoxItem Content="Consolas" Tag="Consolas" />
                                <ComboBoxItem Content="Ink Free" Tag="Ink Free" />
                            </ComboBox>
                            <Grid ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <NumberBox x:Name="ClipFontSizeBox" Header="Size (1080p px)" Minimum="8" Maximum="400" SmallChange="4" SpinButtonPlacementMode="Compact" ValueChanged="ClipNumber_Changed" />
                                <ComboBox x:Name="ClipColourSelector" Grid.Column="1" Header="Colour" HorizontalAlignment="Stretch" SelectionChanged="ClipChoice_Changed">
                                    <ComboBoxItem Content="White" Tag="FFFFFFFF" />
                                    <ComboBoxItem Content="Black" Tag="FF000000" />
                                    <ComboBoxItem Content="Yellow" Tag="FFFFD60A" />
                                    <ComboBoxItem Content="Orange" Tag="FFFFA500" />
                                    <ComboBoxItem Content="Red" Tag="FFE5484D" />
                                    <ComboBoxItem Content="Blue" Tag="FF3E9BFF" />
                                </ComboBox>
                            </Grid>
                            <Slider x:Name="ClipScaleSlider" Header="Scale" Minimum="0.05" Maximum="4" StepFrequency="0.05" ValueChanged="ClipProperty_Changed" LostFocus="ClipProperty_LostFocus" />
                            <NumberBox x:Name="ClipRotationBox" Header="Image rotation (degrees clockwise)" Minimum="-180" Maximum="180" Value="0" SmallChange="5" SpinButtonPlacementMode="Compact" ValueChanged="ClipRotation_Changed" LostFocus="ClipProperty_LostFocus" />
                            <Slider x:Name="ClipXSlider" Header="Horizontal position" Minimum="0" Maximum="1" StepFrequency="0.01" ValueChanged="ClipProperty_Changed" LostFocus="ClipProperty_LostFocus" />
                            <Slider x:Name="ClipYSlider" Header="Vertical position" Minimum="0" Maximum="1" StepFrequency="0.01" ValueChanged="ClipProperty_Changed" LostFocus="ClipProperty_LostFocus" />
                        </StackPanel>
                        <Border Style="{StaticResource DividerStyle}" />
                        <TextBlock Text="PROJECT MEDIA BIN" Style="{StaticResource SectionHeaderTextStyle}" />
                        <TextBlock Text="Project-linked video, images and audio, grouped by source path. Missing links are highlighted. Search a folder recursively by exact filename; ambiguous duplicate names are never auto-selected." TextWrapping="Wrap" Style="{StaticResource HintTextStyle}" />
                        <ComboBox x:Name="ProjectMediaBinList" Header="Project media" HorizontalAlignment="Stretch" SelectionChanged="ProjectMediaBin_SelectionChanged" />
                        <Button x:Name="FindMediaMatchesButton" Content="Find missing media in folder..." Click="FindMediaMatches_Click" IsEnabled="False" />
                        <ComboBox x:Name="MediaBinMatchesList" Header="Unique exact filename matches" HorizontalAlignment="Stretch" SelectionChanged="MediaBinMatch_SelectionChanged" />
                        <CheckBox x:Name="MediaBinUseReplacementEnd" Content="Use replacement end for unresolved audio clips" />
                        <Button x:Name="RelinkMediaMatchButton" Content="Relink selected missing source" Click="RelinkMediaMatch_Click" IsEnabled="False" />
                        <TextBlock x:Name="ProjectMediaBinStatus" Text="Open a project or add media to populate the bin." TextWrapping="Wrap" Style="{StaticResource HintTextStyle}" />
                        <TextBlock Text="Relinking applies to all same-kind uses of that exact project path and is atomic/undoable. Video source ranges must fit; audio end points and fade duration must fit. For missing audio clips with no saved source end, enable the checkbox only if extending/shortening them to the replacement end is intended. Media is never changed on disk." TextWrapping="Wrap" Style="{StaticResource HintTextStyle}" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <Grid x:Name="ExportInspectorPanel" Grid.Row="0" Grid.Column="2" Style="{StaticResource PanelStyle}" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Padding="18" Spacing="12">
                        <TextBlock Text="Export" Style="{StaticResource PanelTitleTextStyle}" />
                        <TextBlock Text="Render the edited timeline to MP4. Original/Modified only affects the viewer, not export." Style="{StaticResource HintTextStyle}" />
                        <TextBlock Text="RESOLUTION" Style="{StaticResource SectionHeaderTextStyle}" />
                        <ComboBox x:Name="ExportResolutionSelector" SelectedIndex="1" SelectionChanged="ExportResolution_SelectionChanged">
                            <ComboBoxItem Content="720p · 1280 × 720" Tag="P720" />
                            <ComboBoxItem Content="1080p · 1920 × 1080" Tag="P1080" />
                            <ComboBoxItem Content="1440p · 2560 × 1440" Tag="P1440" />
                            <ComboBoxItem Content="4K UHD · 3840 × 2160" Tag="Uhd4K" />
                        </ComboBox>
                        <NumberBox x:Name="ExportFrameRateBox" Header="Output frame rate (24–120 fps)" Minimum="24" Maximum="120"
                                   Value="24" SmallChange="1" SpinButtonPlacementMode="Compact" ValueChanged="ExportFrameRate_Changed" />
                        <TextBlock x:Name="ExportProfileReadout" TextWrapping="Wrap" Text="1920 × 1080 · 24 fps" Style="{StaticResource LabelTextStyle}" />
                        <ComboBox x:Name="ExportCodecSelector" Header="Codec" SelectedIndex="0" HorizontalAlignment="Stretch" SelectionChanged="ExportResolution_SelectionChanged">
                            <ComboBoxItem Content="H.264 · plays everywhere" Tag="H264" />
                            <ComboBoxItem Content="HEVC (H.265) · smaller files" Tag="Hevc" />
                        </ComboBox>
                        <ToggleSwitch x:Name="ExportHardwareToggle" Header="Hardware transforms" OnContent="Prefer hardware transforms" OffContent="Disable hardware transforms" IsOn="True" />
                        <Button x:Name="CheckVideoEncodersButton" Content="Check video encoder profiles" Click="CheckVideoEncoders_Click" />
                        <Button x:Name="MeasureVideoPerformanceButton" Content="Measure selected profile (2 seconds)" Click="MeasureVideoPerformance_Click" />
                        <TextBlock x:Name="VideoEncoderCapabilitiesText" Text="Probe H.264/HEVC software encode support across common resolutions and frame rates. Hardware encoder use is not confirmed by Media Foundation's preference flag." TextWrapping="Wrap" Style="{StaticResource HintTextStyle}" />
                        <Slider x:Name="ExportQualitySlider" Header="Video quality / file size" Minimum="0" Maximum="100" Value="50"
                                StepFrequency="1" ValueChanged="ExportSettings_Changed" AutomationProperties.Name="Video quality and file size" />
                        <Grid>
                            <TextBlock Text="Lower quality / smaller" Style="{StaticResource HintTextStyle}" />
                            <TextBlock Text="Higher quality / larger" HorizontalAlignment="Right" Style="{StaticResource HintTextStyle}" />
                        </Grid>
                        <ComboBox x:Name="VideoAudioRateSelector" Header="MP4 AAC sample rate" SelectedIndex="1" HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="44.1 kHz" Tag="44100" />
                            <ComboBoxItem Content="48 kHz" Tag="48000" />
                        </ComboBox>
                        <ComboBox x:Name="VideoAudioBitRateSelector" Header="MP4 AAC bit rate" SelectedIndex="2" HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="128 kbps" Tag="128000" />
                            <ComboBoxItem Content="160 kbps" Tag="160000" />
                            <ComboBoxItem Content="192 kbps" Tag="192000" />
                        </ComboBox>
                        <TextBlock Text="MP4 uses lossy AAC; PCM bit depth does not apply. Encoder support depends on Windows. Use WAV below for 16-32-bit and rates up to 384 kHz." TextWrapping="Wrap" Style="{StaticResource HintTextStyle}" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="ExportVideoButton" Content="Export video…" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" Click="ExportVideo_Click" ToolTipService.ToolTip="Render every visible track, ink layer and the audio mix to an MP4 file" />
                            <Button x:Name="CancelExportButton" Grid.Column="1" Content="Cancel" Visibility="Collapsed" Click="CancelExport_Click" />
                        </Grid>
                        <ProgressBar x:Name="ExportProgressBar" Maximum="1" Visibility="Collapsed" />
                        <TextBlock x:Name="ExportStatusText" TextWrapping="Wrap" FontSize="12" Style="{StaticResource LabelTextStyle}" Visibility="Collapsed" />
                        <TextBlock Text="EXPORT JOBS" Style="{StaticResource SectionHeaderTextStyle}" />
                        <ComboBox x:Name="ExportJobsSelector" Header="Saved jobs on this PC" DisplayMemberPath="DisplayText"
                                  HorizontalAlignment="Stretch" SelectionChanged="ExportJob_SelectionChanged" />
                        <TextBlock x:Name="ExportJobsSummaryText" Text="Scanning export jobs..." TextWrapping="Wrap" Style="{StaticResource HintTextStyle}" />
                        <Button x:Name="RetryExportJobButton" Content="Retry saved job" IsEnabled="False" Click="RetryExportJob_Click"
                                ToolTipService.ToolTip="Restart a failed, cancelled or interrupted export from its saved snapshot, replacing the same output file" />
                        <TextBlock Text="Exports run in separate processes and continue when the editor closes or crashes. Reopening InkMotion reconnects to active jobs. Keep source files available. A worker crash or Windows restart interrupts a job; it is not automatically resumed." TextWrapping="Wrap" Style="{StaticResource HintTextStyle}" />
                        <Border Style="{StaticResource DividerStyle}" />
                        <TextBlock Text="AUDIO MIX FILE" Style="{StaticResource SectionHeaderTextStyle}" />
                        <TextBlock Text="Export a separate audio mix below for other formats and rates. WAV preserves the project channel layout; MP3 and AAC use mono/stereo." Style="{StaticResource HintTextStyle}" />
                        <UserControl x:Name="AudioExportOptions">
                            <StackPanel Spacing="10">
                                <ComboBox x:Name="AudioExportCodecSelector" Header="Audio codec / container" SelectedIndex="0" HorizontalAlignment="Stretch" SelectionChanged="AudioExportCodec_Changed">
                                    <ComboBoxItem Content="PCM · WAV" />
                                    <ComboBoxItem Content="32-bit float · WAV" />
                                    <ComboBoxItem Content="MP3 · Windows encoder required" />
                                    <ComboBoxItem Content="AAC · M4A · Windows encoder required" />
                                </ComboBox>
                                <ComboBox x:Name="AudioExportRateSelector" Header="Sample rate (Hz)" HorizontalAlignment="Stretch" />
                                <ComboBox x:Name="AudioExportDepthSelector" Header="PCM bit depth" SelectedIndex="1" HorizontalAlignment="Stretch">
                                    <ComboBoxItem Content="16-bit" Tag="16" />
                                    <ComboBoxItem Content="24-bit" Tag="24" />
                                    <ComboBoxItem Content="32-bit" Tag="32" />
                                </ComboBox>
                                <ComboBox x:Name="AudioExportBitRateSelector" Header="Lossy audio bit rate" SelectedIndex="2" HorizontalAlignment="Stretch">
                                    <ComboBoxItem Content="128 kbps" Tag="128000" />
                                    <ComboBoxItem Content="160 kbps" Tag="160000" />
                                    <ComboBoxItem Content="192 kbps" Tag="192000" />
                                    <ComboBoxItem Content="256 kbps" Tag="256000" />
                                    <ComboBoxItem Content="320 kbps" Tag="320000" />
                                </ComboBox>
                            </StackPanel>
                        </UserControl>
                        <Button x:Name="ExportAudioButton" Content="Export audio mix…" Click="ExportAudio_Click" />
                        <Button x:Name="CheckAudioEncodersButton" Content="Check installed audio encoders" Click="CheckAudioEncoders_Click" />
                        <TextBlock x:Name="AudioEncoderCapabilitiesText" Text="Windows MP3/AAC format availability varies by PC. Export requires an exact rate, channel count and bit rate match; unsupported combinations report an error rather than substituting settings." TextWrapping="Wrap" Style="{StaticResource HintTextStyle}" />
                        <Border Style="{StaticResource DividerStyle}" />
                        <TextBlock Text="Export renders with Win2D and asks Media Foundation to enable hardware transforms when preferred. Windows does not report the actual encoder hardware through this API, so GPU encoder use cannot be claimed. Every visible video, image and title track is composited in timeline order with the ink layers on top. Surround mixes beyond 5.1 are also saved as a multichannel WAV beside the video." TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <Grid x:Name="AudioInspectorPanel" Grid.Row="0" Grid.Column="2" Style="{StaticResource PanelStyle}" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Padding="18" Spacing="12">
                        <TextBlock Text="Audio Editor" Style="{StaticResource PanelTitleTextStyle}" />
                        <TextBlock Text="PROJECT MIX" Style="{StaticResource SectionHeaderTextStyle}" />
                        <ComboBox x:Name="AudioMixLayoutSelector" Header="Channel layout" SelectedIndex="1" SelectionChanged="AudioMixLayout_SelectionChanged" HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="Mono (1.0)" Tag="Mono" />
                            <ComboBoxItem Content="Stereo (2.0)" Tag="Stereo" />
                            <ComboBoxItem Content="Quad (4.0)" Tag="Quad" />
                            <ComboBoxItem Content="5.1 surround" Tag="Surround51" />
                            <ComboBoxItem Content="7.1 surround" Tag="Surround71" />
                            <ComboBoxItem Content="7.1.4 immersive" Tag="Surround714" />
                            <ComboBoxItem Content="12.1 immersive" Tag="Surround121" />
                        </ComboBox>
                        <TextBlock x:Name="AudioMixLayoutText" Text="2 channels · L R" TextWrapping="Wrap" FontSize="12" Style="{StaticResource LabelTextStyle}" />
                        <Border Style="{StaticResource DividerStyle}" />
                        <TextBlock Text="MIXER" Style="{StaticResource SectionHeaderTextStyle}" />
                        <TextBlock x:Name="AudioTrackLabel" Text="No audio track selected" TextWrapping="Wrap" Style="{StaticResource LabelTextStyle}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ToggleButton x:Name="AudioMuteButton" Content="Mute" Click="AudioMute_Click" />
                            <ToggleButton x:Name="AudioSoloButton" Content="Solo" Click="AudioSolo_Click" IsEnabled="False" />
                            <Slider x:Name="AudioVolumeSlider" Width="150" Minimum="0" Maximum="1" Value="1" StepFrequency="0.05" ValueChanged="AudioVolume_Changed" />
                        </StackPanel>
                        <NumberBox x:Name="AudioBalanceBox" Header="Balance (-100 left, +100 right)" Minimum="-100" Maximum="100" Value="0" SmallChange="5" SpinButtonPlacementMode="Compact" ValueChanged="AudioBalance_ValueChanged" IsEnabled="False" />
                        <TextBlock Text="Balance attenuates left/right speakers; centre/LFE stay unchanged. Solo isolates marked audio tracks and bypasses video-source sound. Mute takes priority over solo." TextWrapping="Wrap" Style="{StaticResource HintTextStyle}" />
                        <ToggleSwitch x:Name="AudioSpatialPanToggle" Header="Spatial azimuth pan (mono sources)" OnContent="Enabled" OffContent="Disabled" Toggled="AudioSpatialPan_Toggled" IsEnabled="False" />
                        <NumberBox x:Name="AudioSpatialPanAzimuthBox" Header="Azimuth (-180° to +180°)" Minimum="-180" Maximum="180" Value="0" SmallChange="15" SpinButtonPlacementMode="Compact" ValueChanged="AudioSpatialPanAzimuth_ValueChanged" IsEnabled="False" />
                        <TextBlock Text="Positions a mono clip around the horizontal speaker layout with equal-power panning. Stereo balance is bypassed while spatial pan is enabled; height and LFE channels are not pan targets. Preview folds to stereo, while export uses the selected mix layout." TextWrapping="Wrap" Style="{StaticResource HintTextStyle}" />
                        <TextBlock Text="LIVE PREVIEW MASTER" Style="{StaticResource SectionHeaderTextStyle}" />
                        <ProgressBar x:Name="MasterAudioMeterProgress" Minimum="0" Maximum="100" Value="0" AutomationProperties.Name="Live preview master peak level" />
                        <TextBlock x:Name="MasterAudioMeterText" Text="Preview master: stopped" TextWrapping="Wrap" Style="{StaticResource HintTextStyle}" />
                        <TextBlock Text="Measures peak, RMS and latched clipping from the actual summed stereo samples routed through InkMotion's preview mix, including routed video audio. It is pre-device and pre-encoding, not true peak or LUFS." TextWrapping="Wrap" Style="{StaticResource HintTextStyle}" />
                        <Border Style="{StaticResource DividerStyle}" />
                        <TextBlock Text="RECORDING" Style="{StaticResource SectionHeaderTextStyle}" />
                        <ComboBox x:Name="AudioRecordingDeviceSelector" Header="Input device" />
                        <ComboBox x:Name="AudioRecordingSampleRateSelector" Header="Sample rate" />
                        <Button x:Name="AudioRecordingButton" Content="Record audio" Click="AudioRecordingButton_Click" IsEnabled="False" />
                        <TextBlock x:Name="AudioRecordingStatus" Text="Detecting audio inputs..." TextWrapping="Wrap" Style="{StaticResource HintTextStyle}" />
                        <TextBlock Text="Each take records one selected input as 16-bit PCM WAV and adds it as a new clip at the start frame. Files are kept in InkMotion's local Recordings folder. System-audio loopback and live input monitoring are not included." TextWrapping="Wrap" Style="{StaticResource HintTextStyle}" />
                        <ProgressBar x:Name="AudioMeterProgress" Minimum="0" Maximum="100" Value="0" AutomationProperties.Name="Selected audio track monitor peak level" />
                        <TextBlock x:Name="AudioMeterText" Text="Selected track monitor: stopped" TextWrapping="Wrap" Style="{StaticResource HintTextStyle}" />
                        <Button Content="Reset clip indicators" Click="ResetAudioClipIndicator_Click" />
                        <TextBlock Text="Meters show this track's stereo monitor after effects/balance, not the summed master mix. Full scale or higher latches CLIP." TextWrapping="Wrap" Style="{StaticResource HintTextStyle}" />
                        <TextBlock Text="MASTER MIX ANALYSIS" Style="{StaticResource SectionHeaderTextStyle}" />
                        <Button x:Name="AnalyseAudioMasterButton" Content="Analyse complete export mix" Click="AnalyseAudioMaster_Click" />
                        <Button x:Name="CancelAudioMasterButton" Content="Cancel / clear master analysis" Click="CancelAudioMaster_Click" IsEnabled="False" />
                        <ProgressBar x:Name="AudioMasterScanProgress" Minimum="0" Maximum="100" Visibility="Collapsed" AutomationProperties.Name="Master mix analysis progress" />
                        <ProgressBar x:Name="AudioMasterPeakProgress" Minimum="0" Maximum="100" AutomationProperties.Name="Master mix snapshot sample peak level" />
                        <TextBlock x:Name="AudioMasterText" Text="Analyse the complete export mix to measure summed sample peaks and RMS." TextWrapping="Wrap" Style="{StaticResource HintTextStyle}" />
                        <TextBlock Text="Snapshot analysis, not a live playback meter. Measures the actual summed export samples at 48 kHz in the project channel layout, including video-source audio. Original/Modified affects only playback. Levels are before final encoding/downmix; not true peak or LUFS. Results and CLIP are held until cleared, re-analysed or the project is edited. Keep source files unchanged while analysing." TextWrapping="Wrap" Style="{StaticResource HintTextStyle}" />
                        <Button x:Name="MoveAudioClipButton" Content="Set clip start to playhead" Click="MoveAudioClipToPlayhead_Click" IsEnabled="False" />
                        <Border Style="{StaticResource DividerStyle}" />
                        <TextBlock Text="CLIP EDITING" Style="{StaticResource SectionHeaderTextStyle}" />
                        <Button x:Name="RelinkMatchingAudioSourcesButton" Content="Relink all matching audio sources..." Click="RelinkMatchingAudioSources_Click" IsEnabled="False" />
                        <CheckBox x:Name="AudioRelinkUseReplacementEnd" Content="Use replacement end for unresolved clips" />
                        <TextBlock Text="Relinks all audio tracks using the selected source, including missing files. Keeps placement, processing and tags. Validates every source range before changing links; undo restores all links. Known source ends are retained. Missing sources without a saved end are rejected unless the option above is enabled; that option can change their duration to the replacement end. Spatial panning requires a mono replacement." TextWrapping="Wrap" Style="{StaticResource HintTextStyle}" />
                        <TextBlock x:Name="AudioClipRangeText" Text="No clip selected" TextWrapping="Wrap" FontSize="12" Style="{StaticResource LabelTextStyle}" />
                        <UserControl x:Name="AudioSourceRangeActions" IsEnabled="False">
                          <StackPanel Spacing="8">
                            <NumberBox x:Name="AudioSourceFirstSampleBox" Header="Source start sample frame (zero-based)" Minimum="0" Maximum="9007199254740991" SmallChange="1" SpinButtonPlacementMode="Compact" ValueChanged="AudioSourceSampleSelection_ValueChanged" />
                            <NumberBox x:Name="AudioSourceEndSampleBox" Header="Source end sample frame (excluded)" Minimum="1" Maximum="9007199254740991" SmallChange="1" SpinButtonPlacementMode="Compact" ValueChanged="AudioSourceSampleSelection_ValueChanged" />
                            <Button Content="Apply source sample range" Click="ApplyAudioSourceSamples_Click" />
                            <TextBlock x:Name="AudioSourceSamplesText" Text="Load an audio clip to set sample-based source endpoints." TextWrapping="Wrap" Style="{StaticResource HintTextStyle}" />
                            <TextBlock Text="Edits both source endpoints together, independently of the project video frame rate. Keeps the timeline start, tempo/pitch and other settings; duration can change. Existing fades must fit. Saved source endpoints use seconds; the boxes show source sample boundaries. Switch waveform drag to Source samples to set these fields, then apply to trim the clip." TextWrapping="Wrap" Style="{StaticResource HintTextStyle}" />
                            <TextBlock Text="SOURCE SAMPLE ZOOM" Style="{StaticResource SectionHeaderTextStyle}" />
                            <Button x:Name="ShowAudioSamplesButton" Content="Show samples at source start field" Click="AudioSampleWindow_Click" />
                            <UserControl x:Name="AudioSampleWaveformNavigation" IsEnabled="False">
                              <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Button Content="Zoom in" Tag="in" Click="AudioSampleWindow_Click" />
                                    <Button Content="Zoom out" Tag="out" Click="AudioSampleWindow_Click" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Button Content="Previous window" Tag="previous" Click="AudioSampleWindow_Click" />
                                    <Button Content="Next window" Tag="next" Click="AudioSampleWindow_Click" />
                                </StackPanel>
                              </StackPanel>
                            </UserControl>
                            <TextBlock x:Name="AudioSampleWaveformText" Text="Show a source window, then zoom to individual samples or step through the clip." TextWrapping="Wrap" Style="{StaticResource HintTextStyle}" />
                            <canvas:CanvasControl x:Name="AudioSampleWaveformSurface" Height="100" Draw="AudioSampleWaveform_Draw"
                                PointerPressed="AudioSampleWaveform_PointerPressed" PointerMoved="AudioSampleWaveform_PointerMoved"
                                PointerReleased="AudioSampleWaveform_PointerReleased" PointerCaptureLost="AudioSampleWaveform_PointerCaptureLost"
                                AutomationProperties.Name="Per-channel source sample waveform; drag to set source trim fields" />
                            <TextBlock Text="Session-only source view before tempo, gain, fades and effects; not a timeline zoom. Shows up to 32768 sample frames, separately per channel. Zoom to see individual sample dots; wider windows show min/max envelopes. Vertical scale is fixed at -1 to +1; over-range samples are visually clipped. Drag selects whole source sample frames with the end excluded; no source files are changed. Use the numeric trim fields for keyboard selection." TextWrapping="Wrap" Style="{StaticResource HintTextStyle}" />
                          </StackPanel>
                        </UserControl>
                        <UserControl x:Name="AudioRangeActions" IsEnabled="False">
                            <StackPanel Spacing="8">
                                <ToggleSwitch x:Name="AudioWaveformSampleSelectionToggle" Header="Waveform drag selects source samples" OnContent="Source samples" OffContent="Timeline frames" Toggled="AudioWaveformSelectionMode_Toggled" />
                                <TextBlock Text="Timeline frame range (end excluded)" Style="{StaticResource LabelTextStyle}" />
                                <TextBlock Text="With the switch off, drag across a waveform to set this range. Timeline range actions remain project-frame based; the end boundary is excluded." TextWrapping="Wrap" Style="{StaticResource HintTextStyle}" />
                                <NumberBox x:Name="AudioRangeStartBox" Header="Range start" Minimum="1" Maximum="2147483647" Value="1" SmallChange="1" SpinButtonPlacementMode="Compact" ValueChanged="AudioRange_ValueChanged" />
                                <NumberBox x:Name="AudioRangeEndBox" Header="Range end" Minimum="1" Maximum="2147483647" Value="2" SmallChange="1" SpinButtonPlacementMode="Compact" ValueChanged="AudioRange_ValueChanged" />
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Button Content="Start here" Tag="start" Click="AudioRangeBoundary_Click" ToolTipService.ToolTip="Use the playhead as the range start" />
                                    <Button Content="End here" Tag="end" Click="AudioRangeBoundary_Click" ToolTipService.ToolTip="Use the playhead as the excluded range end" />
                                    <Button Content="All" Tag="all" Click="AudioRangeBoundary_Click" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Button Content="Copy" Tag="copy" Click="AudioRangeAction_Click" />
                                    <Button Content="Cut" Tag="cut" Click="AudioRangeAction_Click" />
                                    <Button Content="Delete" Tag="delete" Click="AudioRangeAction_Click" />
                                    <Button Content="Silence" Tag="silence" Click="AudioRangeAction_Click" />
                                </StackPanel>
                                <TextBlock Text="Cut/delete leaves a gap; silence creates a muted segment. Split portions use separate tracks and retain outer fades." TextWrapping="Wrap" Style="{StaticResource HintTextStyle}" />
                            </StackPanel>
                        </UserControl>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="TrimAudioStartButton" Content="Trim start" Click="TrimAudioStart_Click" IsEnabled="False" ToolTipService.ToolTip="Remove audio before the playhead" />
                            <Button x:Name="TrimAudioEndButton" Content="Trim end" Click="TrimAudioEnd_Click" IsEnabled="False" ToolTipService.ToolTip="Remove audio after the playhead" />
                            <Button x:Name="SplitAudioButton" Content="Split" Click="SplitAudio_Click" IsEnabled="False" ToolTipService.ToolTip="Split the clip at the playhead onto a new track" />
                        </StackPanel>
                        <NumberBox x:Name="AudioFadeInBox" Header="Fade in (seconds)" Minimum="0" Maximum="600" SmallChange="0.1" LargeChange="1" Value="0" SpinButtonPlacementMode="Compact" ValueChanged="AudioFade_ValueChanged" IsEnabled="False" />
                        <Button Content="Join with next audio track" Click="JoinAudioClips_Click" IsEnabled="{Binding IsEnabled, ElementName=SplitAudioButton}" />
                        <TextBlock Text="Joins consecutive portions of the same source with matching processing/tags and no fades at the join. Keeps outer fades; removes the next track. Effects then run continuously rather than resetting at the old split." TextWrapping="Wrap" Style="{StaticResource HintTextStyle}" />
                        <NumberBox x:Name="AudioFadeOutBox" Header="Fade out (seconds)" Minimum="0" Maximum="600" SmallChange="0.1" LargeChange="1" Value="0" SpinButtonPlacementMode="Compact" ValueChanged="AudioFade_ValueChanged" IsEnabled="False" />
                        <NumberBox x:Name="AudioTempoBox" Header="Tempo (%) — keeps pitch" Minimum="50" Maximum="200" SmallChange="1" LargeChange="10" Value="100" SpinButtonPlacementMode="Compact" ValueChanged="AudioTempoPitch_ValueChanged" IsEnabled="False" />
                        <NumberBox x:Name="AudioPitchBox" Header="Pitch (semitones) — keeps tempo" Minimum="-12" Maximum="12" SmallChange="1" LargeChange="12" Value="0" SpinButtonPlacementMode="Compact" ValueChanged="AudioTempoPitch_ValueChanged" IsEnabled="False" />
                        <Button x:Name="ResetAudioTempoPitchButton" Content="Reset tempo and pitch" Click="ResetAudioTempoPitch_Click" IsEnabled="False" />
                        <TextBlock x:Name="AudioGainText" Text="Clip gain: 0.0 dB" Style="{StaticResource LabelTextStyle}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="NormaliseAudioButton" Content="Normalise to −1 dBFS" Click="NormaliseAudio_Click" IsEnabled="False" />
                            <Button x:Name="ResetAudioGainButton" Content="Reset gain" Click="ResetAudioGain_Click" IsEnabled="False" />
                        </StackPanel>
                        <Border Style="{StaticResource DividerStyle}" />
                        <TextBlock Text="NON-DESTRUCTIVE EFFECTS" Style="{StaticResource SectionHeaderTextStyle}" />
                        <UserControl x:Name="AudioEffectsControls" IsEnabled="False">
                            <StackPanel Spacing="8">
                                <ToggleButton x:Name="AudioEffectsEnabled" Content="Enable audio processing chain" Click="AudioEffectsChanged" />
                                <TextBlock Text="Applied after tempo/pitch, before balance. Filters are off at 0 Hz; frequencies above 45% of the source rate are capped. EQ can add headroom demands; lower clip gain if clipping occurs." TextWrapping="Wrap" Style="{StaticResource HintTextStyle}" />
                                <NumberBox x:Name="AudioHighPassBox" Header="High-pass (Hz; 0 = off)" Minimum="0" Maximum="20000" Value="0" SmallChange="20" SpinButtonPlacementMode="Compact" ValueChanged="AudioEffectNumberChanged" />
                                <NumberBox x:Name="AudioLowPassBox" Header="Low-pass (Hz; 0 = off)" Minimum="0" Maximum="20000" Value="0" SmallChange="100" SpinButtonPlacementMode="Compact" ValueChanged="AudioEffectNumberChanged" />
                                <NumberBox x:Name="AudioBassBox" Header="Bass shelf at 120 Hz (dB)" Minimum="-24" Maximum="24" Value="0" SmallChange="1" SpinButtonPlacementMode="Compact" ValueChanged="AudioEffectNumberChanged" />
                                <NumberBox x:Name="AudioMidBox" Header="Mid EQ at 1 kHz (dB)" Minimum="-24" Maximum="24" Value="0" SmallChange="1" SpinButtonPlacementMode="Compact" ValueChanged="AudioEffectNumberChanged" />
                                <NumberBox x:Name="AudioTrebleBox" Header="Treble shelf at 6 kHz (dB)" Minimum="-24" Maximum="24" Value="0" SmallChange="1" SpinButtonPlacementMode="Compact" ValueChanged="AudioEffectNumberChanged" />
                                <NumberBox x:Name="AudioCompressorThresholdBox" Header="Compressor threshold (dBFS)" Minimum="-60" Maximum="0" Value="0" SmallChange="1" SpinButtonPlacementMode="Compact" ValueChanged="AudioEffectNumberChanged" />
                                <NumberBox x:Name="AudioCompressorRatioBox" Header="Compressor ratio (1 = off)" Minimum="1" Maximum="20" Value="1" SmallChange="0.5" SpinButtonPlacementMode="Compact" ValueChanged="AudioEffectNumberChanged" />
                                <NumberBox x:Name="AudioCompressorAttackBox" Header="Attack (ms)" Minimum="0.1" Maximum="200" Value="10" SmallChange="1" SpinButtonPlacementMode="Compact" ValueChanged="AudioEffectNumberChanged" />
                                <NumberBox x:Name="AudioCompressorReleaseBox" Header="Release (ms)" Minimum="5" Maximum="2000" Value="100" SmallChange="10" SpinButtonPlacementMode="Compact" ValueChanged="AudioEffectNumberChanged" />
                                <TextBlock Text="Linked peak compressor with no make-up gain or look-ahead. Bypass retains settings. Playback/seek resets processing history." TextWrapping="Wrap" Style="{StaticResource HintTextStyle}" />
                                <ToggleButton x:Name="AudioGateEnabled" Content="Noise gate" Click="AudioEffectsChanged" />
                                <NumberBox x:Name="AudioGateThresholdBox" Header="Gate threshold (dBFS)" Minimum="-90" Maximum="0" Value="-40" SmallChange="1" SpinButtonPlacementMode="Compact" ValueChanged="AudioEffectNumberChanged" />
                                <NumberBox x:Name="AudioGateAttackBox" Header="Gate attack (ms)" Minimum="0.1" Maximum="200" Value="5" SmallChange="1" SpinButtonPlacementMode="Compact" ValueChanged="AudioEffectNumberChanged" />
                                <NumberBox x:Name="AudioGateHoldBox" Header="Gate hold (ms)" Minimum="0" Maximum="1000" Value="20" SmallChange="5" SpinButtonPlacementMode="Compact" ValueChanged="AudioEffectNumberChanged" />
                                <NumberBox x:Name="AudioGateReleaseBox" Header="Gate release (ms)" Minimum="5" Maximum="2000" Value="100" SmallChange="5" SpinButtonPlacementMode="Compact" ValueChanged="AudioEffectNumberChanged" />
                                <TextBlock Text="Linked-channel gate after EQ, before compression. Closes 3 dB below threshold after hold, with smoothed attack/release. It attenuates quiet passages, not noise under speech." TextWrapping="Wrap" Style="{StaticResource HintTextStyle}" />
                                <ToggleButton x:Name="AudioReverbEnabled" Content="Algorithmic reverb" Click="AudioEffectsChanged" />
                                <NumberBox x:Name="AudioReverbRoomBox" Header="Reverb room scale (0.5-2)" Minimum="0.5" Maximum="2" Value="1" SmallChange="0.1" SpinButtonPlacementMode="Compact" ValueChanged="AudioEffectNumberChanged" />
                                <NumberBox x:Name="AudioReverbDecayBox" Header="Nominal reverb decay (seconds)" Minimum="0.1" Maximum="10" Value="1.5" SmallChange="0.1" SpinButtonPlacementMode="Compact" ValueChanged="AudioEffectNumberChanged" />
                                <NumberBox x:Name="AudioReverbDampingBox" Header="High-frequency damping (0-0.95)" Minimum="0" Maximum="0.95" Value="0.3" SmallChange="0.05" SpinButtonPlacementMode="Compact" ValueChanged="AudioEffectNumberChanged" />
                                <NumberBox x:Name="AudioReverbWetBox" Header="Reverb gain (0-1; dry unchanged)" Minimum="0" Maximum="1" Value="0.25" SmallChange="0.05" SpinButtonPlacementMode="Compact" ValueChanged="AudioEffectNumberChanged" />
                                <TextBlock Text="Four damped feedback combs and two all-pass diffusers per source channel, after compression and before delay/limiting. Dry audio is retained; channels do not cross-feed. Decay is nominal without damping, not a measured room response. Seek, mute, bypass and setting changes clear history. Tails stop at the clip boundary; this does not extend the timeline." TextWrapping="Wrap" Style="{StaticResource HintTextStyle}" />
                                <ToggleButton x:Name="AudioDelayEnabled" Content="Delay / echo" Click="AudioEffectsChanged" />
                                <NumberBox x:Name="AudioDelayTimeBox" Header="Delay time (ms)" Minimum="1" Maximum="2000" Value="250" SmallChange="10" SpinButtonPlacementMode="Compact" ValueChanged="AudioEffectNumberChanged" />
                                <NumberBox x:Name="AudioDelayFeedbackBox" Header="Delay feedback (0-0.95)" Minimum="0" Maximum="0.95" Value="0.3" SmallChange="0.05" SpinButtonPlacementMode="Compact" ValueChanged="AudioEffectNumberChanged" />
                                <NumberBox x:Name="AudioDelayWetBox" Header="Echo gain (0-1; dry unchanged)" Minimum="0" Maximum="1" Value="0.25" SmallChange="0.05" SpinButtonPlacementMode="Compact" ValueChanged="AudioEffectNumberChanged" />
                                <TextBlock Text="Independent channel echoes after compression, before the limiter. Dry audio is retained. Delay is rounded to the nearest source-rate sample; seek, mute, bypass or setting changes clear its history. Echoes are cut at the clip end; this does not extend the timeline." TextWrapping="Wrap" Style="{StaticResource HintTextStyle}" />
                                <ToggleButton x:Name="AudioLimiterEnabled" Content="Sample-peak limiter" Click="AudioEffectsChanged" />
                                <NumberBox x:Name="AudioLimiterCeilingBox" Header="Limiter ceiling (dBFS)" Minimum="-24" Maximum="0" Value="-1" SmallChange="0.5" SpinButtonPlacementMode="Compact" ValueChanged="AudioEffectNumberChanged" />
                                <NumberBox x:Name="AudioLimiterReleaseBox" Header="Limiter release (ms)" Minimum="5" Maximum="2000" Value="100" SmallChange="5" SpinButtonPlacementMode="Compact" ValueChanged="AudioEffectNumberChanged" />
                                <TextBlock Text="Instant linked gain reduction at the end of this track's chain. No look-ahead or inter-sample/true-peak protection. Downmix, resampling and summed tracks can still exceed full scale." TextWrapping="Wrap" Style="{StaticResource HintTextStyle}" />
                                <Button Content="Reset effects" Click="ResetAudioEffects_Click" />
                            </StackPanel>
                        </UserControl>
                        <Border Style="{StaticResource DividerStyle}" />
                        <TextBlock Text="SOURCE FREQUENCY ANALYSIS" Style="{StaticResource SectionHeaderTextStyle}" />
                        <Button x:Name="AnalyseAudioSpectrumButton" Content="Analyse selected source range" Click="AnalyseAudioSpectrum_Click" IsEnabled="False" />
                        <Button x:Name="AverageAudioSpectrumButton" Content="Average whole selected source range" Tag="average" Click="AnalyseAudioSpectrum_Click" IsEnabled="False" />
                        <TextBlock Text="Whole-range analysis streams all source samples using non-overlapping Hann windows and averages channel/window power, not dB values. Peak and RMS cover the entire range. This is pre-effects source analysis, not a spectrogram or loudness meter. Changing the range or selected clip cancels analysis." TextWrapping="Wrap" Style="{StaticResource HintTextStyle}" />
                        <canvas:CanvasControl x:Name="AudioSpectrumSurface" Height="150" Draw="AudioSpectrumSurface_Draw" AutomationProperties.Name="Source spectrum, logarithmic frequency from 20 Hz to Nyquist, minus 120 to zero dBFS" />
                        <TextBlock Text="20 Hz to Nyquist (logarithmic) | 0 dBFS at top, -120 at bottom" TextWrapping="Wrap" Style="{StaticResource HintTextStyle}" />
                        <TextBlock x:Name="AudioSpectrumText" Text="Analyse the start of the selected source range (up to 32768 samples)." TextWrapping="Wrap" Style="{StaticResource HintTextStyle}" />
                        <TextBlock Text="Snapshot of source audio before tempo, pitch, gain, fades and effects. Channel powers are averaged, so opposite-phase stereo does not cancel. Not a spectrogram or whole-clip average." TextWrapping="Wrap" Style="{StaticResource HintTextStyle}" />
                        <Button x:Name="AnalyseAudioSpectrogramButton" Content="Spectrogram of selected source range" Tag="spectrogram" Click="AnalyseAudioSpectrum_Click" IsEnabled="False" />
                        <Button Content="Cancel / clear source analysis" Click="ClearAudioAnalysis_Click" />
                        <canvas:CanvasControl x:Name="AudioSpectrogramSurface" Height="220" Draw="AudioSpectrogramSurface_Draw" AutomationProperties.Name="Source spectrogram, time left to right, logarithmic frequency 20 Hz at bottom to Nyquist at top" />
                        <TextBlock Text="Time: left to right | Frequency: 20 Hz bottom to Nyquist top (logarithmic) | Colour: black -120, cyan -60, white 0 dBFS" TextWrapping="Wrap" Style="{StaticResource HintTextStyle}" />
                        <TextBlock x:Name="AudioSpectrogramText" Text="Analyse the selected source range to show frequency content over time." TextWrapping="Wrap" Style="{StaticResource HintTextStyle}" />
                        <TextBlock Text="Pre-effects source analysis, not the master mix. Streams every selected sample with non-overlapping Hann FFT windows up to 1024 frames. Up to 256 time columns average consecutive window powers, weighted by sample count; short final windows are normalised and zero-padded. Channel powers are averaged without phase cancellation. Long ranges lose time detail; log display cannot improve FFT frequency resolution. Changing selection cancels analysis." TextWrapping="Wrap" Style="{StaticResource HintTextStyle}" />
                        <Border Style="{StaticResource DividerStyle}" />
                        <TextBlock Text="AUDIO TAGS" Style="{StaticResource SectionHeaderTextStyle}" />
                        <TextBox x:Name="AudioTitleBox" PlaceholderText="Title" TextChanged="AudioTag_TextChanged" LostFocus="AudioTag_LostFocus" />
                        <TextBox x:Name="AudioArtistBox" PlaceholderText="Artist" TextChanged="AudioTag_TextChanged" LostFocus="AudioTag_LostFocus" />
                        <TextBox x:Name="AudioAlbumBox" PlaceholderText="Album" TextChanged="AudioTag_TextChanged" LostFocus="AudioTag_LostFocus" />
                        <TextBox x:Name="AudioGenreBox" PlaceholderText="Genre" TextChanged="AudioTag_TextChanged" LostFocus="AudioTag_LostFocus" />
                        <TextBox x:Name="AudioYearBox" PlaceholderText="Year" TextChanged="AudioTag_TextChanged" LostFocus="AudioTag_LostFocus" />
                        <TextBox x:Name="AudioCommentsBox" PlaceholderText="Project comments" TextChanged="AudioTag_TextChanged" LostFocus="AudioTag_LostFocus" />
                        <TextBlock Text="Comments stay in the project. Other supported tags are written only when requested." TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                        <Button x:Name="WriteAudioTagsButton" Content="Write tags to audio file" Click="WriteAudioTags_Click" IsEnabled="False" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <Grid x:Name="InkInspectorPanel" Grid.Row="0" Grid.Column="2" Style="{StaticResource PanelStyle}" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Padding="18" Spacing="12">
                        <TextBlock Text="Ink Editor" Style="{StaticResource PanelTitleTextStyle}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Click="SelectPen_Click" ToolTipService.ToolTip="Draw with the pen" AutomationProperties.Name="Pen">
                                <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xEE56;" FontSize="14" /><TextBlock Text="Pen" /></StackPanel>
                            </Button>
                            <Button Click="SelectEraser_Click" ToolTipService.ToolTip="Erase using the selected eraser mode" AutomationProperties.Name="Eraser">
                                <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE75C;" FontSize="14" /><TextBlock Text="Eraser" /></StackPanel>
                            </Button>
                        </StackPanel>
                        <TextBlock Text="CANVAS VIEW" Style="{StaticResource SectionHeaderTextStyle}" />
                        <Slider x:Name="InkCanvasZoomSlider" Header="Zoom (%)" Minimum="25" Maximum="400" Value="100"
                                StepFrequency="5" ValueChanged="InkCanvasZoom_Changed" AutomationProperties.Name="Canvas zoom percentage" />
                        <NumberBox x:Name="InkCanvasRotationBox" Header="Canvas rotation (degrees)" Minimum="-180" Maximum="180"
                                   Value="0" SmallChange="5" SpinButtonPlacementMode="Compact" ValueChanged="InkCanvasView_Changed" />
                        <NumberBox x:Name="InkCanvasPanXBox" Header="Horizontal pan (% of viewer width)" Minimum="-200" Maximum="200"
                                   Value="0" SmallChange="5" SpinButtonPlacementMode="Compact" ValueChanged="InkCanvasView_Changed" />
                        <NumberBox x:Name="InkCanvasPanYBox" Header="Vertical pan (% of viewer height)" Minimum="-200" Maximum="200"
                                   Value="0" SmallChange="5" SpinButtonPlacementMode="Compact" ValueChanged="InkCanvasView_Changed" />
                        <Button Content="Reset canvas view" Click="ResetInkCanvasView_Click" />
                        <TextBlock Text="Zoom, pan and rotation move the video and ink together for drawing. They do not change saved coordinates, brush widths or export framing. Other workspaces use the normal view; Ink Editor retains these session settings." TextWrapping="Wrap" Style="{StaticResource HintTextStyle}" />
                        <ToggleButton x:Name="InkGridToggle" Content="Canvas grid" Click="InkGuides_Click" />
                        <NumberBox x:Name="InkGridDivisionsBox" Header="Grid divisions per axis" Minimum="2" Maximum="64" Value="8" SmallChange="1" SpinButtonPlacementMode="Compact" ValueChanged="InkGridDivisions_Changed" />
                        <ToggleButton x:Name="InkCentreGuidesToggle" Content="Centre alignment guides" Click="InkGuides_Click" />
                        <TextBlock Text="Session-only guides follow canvas zoom, pan and rotation. They appear behind ink while paused in Ink Editor only, never in saved drawings or exports. The grid divides each canvas axis equally; it does not snap or constrain strokes." TextWrapping="Wrap" Style="{StaticResource HintTextStyle}" />
                        <TextBlock Text="INK LAYERS" Style="{StaticResource SectionHeaderTextStyle}" />
                        <ComboBox x:Name="InkLayerSelector" DisplayMemberPath="Name" SelectionChanged="InkLayer_SelectionChanged" />
                        <TextBox x:Name="InkLayerNameBox" Header="Layer name" MaxLength="200" />
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Button Content="Rename" Tag="rename" Click="InkLayerAction_Click" />
                            <Button Content="Duplicate" Tag="duplicate" Click="InkLayerAction_Click" />
                            <Button Content="Remove" Tag="remove" Click="InkLayerAction_Click" />
                        </StackPanel>
                        <Button Content="Add ink layer" Click="AddInkLayer_Click" />
                        <Button Content="Flip layer left/right" Tag="flip-horizontal" Click="InkLayerAction_Click" />
                        <Button Content="Flip layer top/bottom" Tag="flip-vertical" Click="InkLayerAction_Click" />
                        <TextBlock Text="Flip the unlocked layer across the canvas centre on every cel. Tweening remains editable; text and other layers are unchanged. Undo restores the drawings." TextWrapping="Wrap" Style="{StaticResource HintTextStyle}" />
                        <Button Content="Merge layer down" Tag="merge" Click="InkLayerAction_Click" />
                        <TextBlock Text="Merge combines this layer with the layer immediately beneath it across all cels. Both must be visible, unlocked and have matching opacity. Generated in-betweens become stored strokes; undo restores the separate layers. Text is unchanged." TextWrapping="Wrap" Style="{StaticResource HintTextStyle}" />
                        <ToggleButton x:Name="InkLayerVisibilityButton" Content="Hide layer" Click="InkLayerVisibility_Click" />
                        <ToggleButton x:Name="InkLayerLockButton" Content="Lock drawing" Click="InkLayerLock_Click" />
                        <TextBlock Text="Drawing lock protects layer strokes, opacity and order. Visibility, cel timing, keyframes, whole-cel operations and cel-global text are unchanged." TextWrapping="Wrap" Style="{StaticResource HintTextStyle}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Opacity" VerticalAlignment="Center" Style="{StaticResource LabelTextStyle}" />
                            <Slider x:Name="InkLayerOpacitySlider" Width="150" Minimum="0" Maximum="1" Value="1" StepFrequency="0.05" ValueChanged="InkLayerOpacity_Changed" LostFocus="InkLayerOpacity_LostFocus" />
                        </StackPanel>
                        <TextBlock Text="BRUSH" Style="{StaticResource SectionHeaderTextStyle}" />
                        <ComboBox x:Name="InkBrushPresetSelector" Header="Round brush preset" PlaceholderText="Apply a preset" HorizontalAlignment="Stretch" SelectionChanged="InkBrushPreset_SelectionChanged" />
                        <TextBlock Text="Presets set width, opacity and stabilisation, retaining hue. All use the same pressure-sensitive round brush; the highlighter has translucent overlapping dabs, not a separate blend mode." TextWrapping="Wrap" Style="{StaticResource HintTextStyle}" />
                        <TextBlock Text="Drawing stabilisation" Style="{StaticResource LabelTextStyle}" />
                        <Slider x:Name="InkStabilisationSlider" Minimum="0" Maximum="0.9" Value="0" StepFrequency="0.1" AutomationProperties.Name="Drawing stabilisation" />
                        <TextBlock Text="Off at the left; stronger smoothing adds pen lag. The stroke ends at the released pointer." Style="{StaticResource HintTextStyle}" TextWrapping="Wrap" />
                        <TextBlock Text="Eraser mode" Style="{StaticResource LabelTextStyle}" />
                        <ComboBox x:Name="InkEraserModeSelector" SelectedIndex="0" SelectionChanged="InkEraserMode_SelectionChanged" AutomationProperties.Name="Eraser mode">
                            <ComboBoxItem Content="Whole stroke" />
                            <ComboBoxItem Content="Partial stroke" />
                        </ComboBox>
                        <TextBlock Text="Eraser radius (preview pixels)" Style="{StaticResource LabelTextStyle}" />
                        <Slider x:Name="InkEraserRadiusSlider" Minimum="2" Maximum="60" Value="18" StepFrequency="1" AutomationProperties.Name="Eraser radius" />
                        <Button Content="Sample drawing colour..." Click="SelectInkColourSampler_Click" />
                        <NumberBox x:Name="InkSampleXBox" Header="Sample X (% across drawing)" Minimum="0" Maximum="100" Value="50" SmallChange="1" SpinButtonPlacementMode="Compact" />
                        <NumberBox x:Name="InkSampleYBox" Header="Sample Y (% down drawing)" Minimum="0" Maximum="100" Value="50" SmallChange="1" SpinButtonPlacementMode="Compact" />
                        <Button Content="Sample drawing at X/Y" Click="SampleInkColourAtCoordinates_Click" />
                        <TextBlock Text="Samples visible ink layers and cel text with their combined opacity, not video, images, timeline titles, background, onion skin or guides. Click once after choosing the sampler, or use X/Y for keyboard access. Empty pixels retain the current colour. Changes the brush only, not the drawing; locked layers can be sampled." TextWrapping="Wrap" Style="{StaticResource HintTextStyle}" />
                        <ComboBox x:Name="InkColourSelector" SelectedIndex="0" SelectionChanged="InkColour_SelectionChanged">
                            <ComboBoxItem Content="Orange" Tag="FFFFA500" />
                            <ComboBoxItem Content="White" Tag="FFFFFFFF" />
                            <ComboBoxItem Content="Cyan" Tag="FF00BFFF" />
                            <ComboBoxItem Content="Pink" Tag="FFFF69B4" />
                            <ComboBoxItem Content="Lime" Tag="FF7CFC00" />
                        </ComboBox>
                        <DropDownButton Content="Custom colour...">
                            <DropDownButton.Flyout>
                                <Flyout>
                                    <ColorPicker x:Name="InkCustomColourPicker" Color="#FFFFA500" IsAlphaEnabled="True" IsAlphaSliderVisible="True" IsAlphaTextInputVisible="True" ColorChanged="InkCustomColour_Changed" />
                                </Flyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Pen size" VerticalAlignment="Center" Style="{StaticResource LabelTextStyle}" />
                            <Slider x:Name="InkWidthSlider" Width="150" Minimum="1" Maximum="12" Value="4" StepFrequency="0.5" ValueChanged="InkWidth_Changed" />
                        </StackPanel>
                        <TextBlock Text="STROKE SELECTION" Style="{StaticResource SectionHeaderTextStyle}" />
                        <TextBlock Text="Lasso selects whole strokes on this cel and layer, not text. Offsets use canvas percentages; rotation uses preview aspect ratio. Brush widths stay unchanged." TextWrapping="Wrap" Style="{StaticResource HintTextStyle}" />
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Button Content="All" Tag="all" Click="InkSelectionAction_Click" />
                            <Button Content="Copy" Tag="copy" Click="InkSelectionAction_Click" />
                            <Button Content="Paste" Tag="paste" Click="InkSelectionAction_Click" />
                            <Button Content="Delete" Tag="delete" Click="InkSelectionAction_Click" />
                        </StackPanel>
                        <NumberBox x:Name="InkSelectionXBox" Header="Horizontal offset (%)" Minimum="-100" Maximum="100" Value="0" SmallChange="1" SpinButtonPlacementMode="Compact" />
                        <NumberBox x:Name="InkSelectionYBox" Header="Vertical offset (%)" Minimum="-100" Maximum="100" Value="0" SmallChange="1" SpinButtonPlacementMode="Compact" />
                        <NumberBox x:Name="InkSelectionScaleBox" Header="Scale (%)" Minimum="1" Maximum="1000" Value="100" SmallChange="5" SpinButtonPlacementMode="Compact" />
                        <NumberBox x:Name="InkSelectionAngleBox" Header="Rotation (degrees)" Minimum="-360" Maximum="360" Value="0" SmallChange="5" SpinButtonPlacementMode="Compact" />
                        <Button Content="Apply selection transform" Tag="transform" Click="InkSelectionAction_Click" />
                        <TextBlock Text="TEXT OVERLAY" Style="{StaticResource SectionHeaderTextStyle}" />
                        <ComboBox x:Name="InkTextOverlaySelector" Header="Existing text on this cel" HorizontalAlignment="Stretch" SelectionChanged="InkTextOverlay_SelectionChanged" />
                        <TextBox x:Name="InkTextBox" PlaceholderText="Type a text overlay" MaxLength="2048" AcceptsReturn="False" />
                        <TextBlock Text="Font" Style="{StaticResource LabelTextStyle}" />
                        <ComboBox x:Name="InkTextFontSelector" SelectedIndex="0">
                            <ComboBoxItem Content="Segoe UI" Tag="Segoe UI" />
                            <ComboBoxItem Content="Arial" Tag="Arial" />
                            <ComboBoxItem Content="Georgia" Tag="Georgia" />
                            <ComboBoxItem Content="Comic Sans MS" Tag="Comic Sans MS" />
                            <ComboBoxItem Content="Consolas" Tag="Consolas" />
                        </ComboBox>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Text size" VerticalAlignment="Center" Style="{StaticResource LabelTextStyle}" />
                            <NumberBox x:Name="InkTextSizeBox" Minimum="6" Maximum="512" Value="48" SmallChange="2" SpinButtonPlacementMode="Compact" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Add text to cel" Click="AddInkText_Click" />
                            <Button Content="Remove last text" Click="RemoveInkText_Click" />
                        </StackPanel>
                        <UserControl x:Name="InkSelectedTextProperties" IsEnabled="False">
                            <StackPanel Spacing="8">
                                <NumberBox x:Name="InkTextXBox" Header="Selected text X (%)" Minimum="0" Maximum="100" Value="50" SmallChange="1" SpinButtonPlacementMode="Compact" />
                                <NumberBox x:Name="InkTextYBox" Header="Selected text Y (%)" Minimum="0" Maximum="100" Value="50" SmallChange="1" SpinButtonPlacementMode="Compact" />
                                <Button Content="Selected text colour">
                                    <Button.Flyout>
                                        <Flyout>
                                            <ColorPicker x:Name="InkSelectedTextColour" IsAlphaEnabled="True" IsAlphaSliderVisible="True" IsAlphaTextInputVisible="True" />
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                            </StackPanel>
                        </UserControl>
                        <Button x:Name="ApplySelectedInkTextButton" Content="Apply to selected text" Click="SelectedInkTextAction_Click" IsEnabled="False" />
                        <Button x:Name="RemoveSelectedInkTextButton" Content="Remove selected text" Tag="remove" Click="SelectedInkTextAction_Click" IsEnabled="False" />
                        <TextBlock Text="Select an existing overlay to load its text, font, size, position and colour. Apply is explicit and undoable; switching cels or overlays discards unapplied edits. Add text still creates a centred overlay using the brush colour. Text is cel-wide, not owned by drawing layers; drawing locks do not prevent text edits. Selection here is by overlay, not by characters or canvas hit-testing." TextWrapping="Wrap" Style="{StaticResource HintTextStyle}" />
                        <TextBlock Text="ANIMATION" Style="{StaticResource SectionHeaderTextStyle}" />
                        <ToggleButton x:Name="OnionSkinToggle" Content="Onion skin" ToolTipService.ToolTip="Show neighbouring animation cels as translucent guides while paused in Ink Editor." Click="OnionSkin_Click" />
                        <NumberBox x:Name="OnionPreviousCountBox" Header="Previous onion cels" Minimum="0" Maximum="8" Value="1" SmallChange="1" SpinButtonPlacementMode="Compact" ValueChanged="OnionCount_Changed" />
                        <NumberBox x:Name="OnionNextCountBox" Header="Next onion cels" Minimum="0" Maximum="8" Value="1" SmallChange="1" SpinButtonPlacementMode="Compact" ValueChanged="OnionCount_Changed" />
                        <Slider x:Name="OnionSkinOpacitySlider" Header="Nearest guide opacity" Minimum="0.05" Maximum="0.6" Value="0.25" StepFrequency="0.05" ValueChanged="OnionSkinOpacity_Changed" />
                        <Slider x:Name="OnionFalloffSlider" Header="Opacity multiplier per farther cel" Minimum="0.1" Maximum="1" Value="1" StepFrequency="0.05" ValueChanged="OnionSkinOpacity_Changed" />
                        <ToggleButton x:Name="OnionOriginalColoursToggle" Content="Retain original guide colours" Click="OnionSkin_Click" />
                        <ToggleButton x:Name="OnionTextToggle" Content="Include text in onion guides" IsChecked="True" Click="OnionSkin_Click" />
                        <TextBlock Text="Counts are cels, not exposure/output frames. Farther guides draw first and fade by the multiplier. Previous ink is cyan and next ink pink unless original colours are retained; text retains its own colour. Session preferences only: guides are hidden during playback and never exported or saved as drawings." TextWrapping="Wrap" Style="{StaticResource HintTextStyle}" />
                        <TextBlock Text="Tween curve" Style="{StaticResource LabelTextStyle}" />
                        <ComboBox x:Name="InkInterpolationSelector" SelectedIndex="0" SelectionChanged="InkInterpolation_SelectionChanged">
                            <ComboBoxItem Content="Linear" Tag="Linear" />
                            <ComboBoxItem Content="Ease in" Tag="EaseIn" />
                            <ComboBoxItem Content="Ease out" Tag="EaseOut" />
                            <ComboBoxItem Content="Ease in and out" Tag="EaseInOut" />
                        </ComboBox>
                        <TextBlock Text="Choose the motion curve from this keyframe to the next." FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}" />
                        <TextBlock x:Name="KeyframeStatus" Text="No keyframe on this cel" TextWrapping="Wrap" Style="{StaticResource LabelTextStyle}" />
                        <TextBlock Text="CEL EXPOSURE" Style="{StaticResource SectionHeaderTextStyle}" />
                        <NumberBox x:Name="ExposureFramesBox" Minimum="1" Maximum="999" Value="1" SmallChange="1" SpinButtonPlacementMode="Compact" ValueChanged="ExposureFrames_Changed" LostFocus="ExposureFrames_LostFocus" />
                        <TextBlock Text="Output frames to hold this cel." FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}" />
                        <TextBlock Text="REPEAT CEL CYCLE" Style="{StaticResource SectionHeaderTextStyle}" />
                        <NumberBox x:Name="InkCycleFirstBox" Header="First cel (inclusive)" Minimum="1" Maximum="2147483647" Value="1" SmallChange="1" SpinButtonPlacementMode="Compact" />
                        <NumberBox x:Name="InkCycleLastBox" Header="Last cel (inclusive)" Minimum="1" Maximum="2147483647" Value="1" SmallChange="1" SpinButtonPlacementMode="Compact" />
                        <NumberBox x:Name="InkCycleCopiesBox" Header="Additional copies" Minimum="1" Maximum="100" Value="1" SmallChange="1" SpinButtonPlacementMode="Compact" />
                        <Button Content="Repeat cel range" Click="RepeatInkCelRange_Click" />
                        <TextBlock Text="Insert independent copies immediately after this range, retaining all layers, text, exposure and tween settings. First and last cels must be keyframes to contain the cycle. Maximum 10,000 added cels per operation. Later cels shift; video, audio and markers stay in place. Drawing locks do not block whole-cel operations. Undo restores the previous timeline." TextWrapping="Wrap" Style="{StaticResource HintTextStyle}" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <Grid x:Name="VideoTimelineWorkspace" Grid.Row="2" Grid.ColumnSpan="3" Style="{StaticResource PanelStyle}" Padding="12,8,12,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,0,0,6">
                    <TextBlock Text="VIDEO TIMELINE" Style="{StaticResource SectionHeaderTextStyle}" VerticalAlignment="Center" />
                    <ToggleButton x:Name="SelectTimelineToolButton" Content="Select" Tag="Select"
                                  IsChecked="True" Click="TimelineToolMode_Click"
                                  ToolTipService.ToolTip="Select and move clips" />
                    <ToggleButton x:Name="BladeTimelineToolButton" Content="Blade" Tag="Blade"
                                  Click="TimelineToolMode_Click"
                                  ToolTipService.ToolTip="Click inside a clip to split it" />
                    <ToggleButton x:Name="TrimTimelineToolButton" Content="Trim" Tag="Trim"
                                  Click="TimelineToolMode_Click"
                                  ToolTipService.ToolTip="Drag a selected clip's start or end handle" />
                    <ToggleButton x:Name="RippleTimelineToolButton" Content="Ripple" Tag="Ripple"
                                  Click="TimelineToolMode_Click"
                                  ToolTipService.ToolTip="Drag a clip edge and ripple later clips on the same track" />
                    <ToggleButton x:Name="RollTimelineToolButton" Content="Roll" Tag="Roll"
                                  Click="TimelineToolMode_Click"
                                  ToolTipService.ToolTip="Drag the cut between adjacent clips" />
                    <ToggleButton x:Name="SlideTimelineToolButton" Content="Slide" Tag="Slide"
                                  Click="TimelineToolMode_Click"
                                  ToolTipService.ToolTip="Drag a clip between adjacent clips" />
                    <TextBlock Text="Zoom" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                    <Slider x:Name="TimelineZoomSlider" Width="140" Minimum="10" Maximum="400" Value="60" StepFrequency="5" VerticalAlignment="Center" ValueChanged="TimelineZoom_Changed" AutomationProperties.Name="Timeline zoom" />
                    <TextBlock x:Name="VideoTimelineHint" Text="Select: move. Blade: split. Trim/Ripple: drag an edge. Roll: drag a cut. Slide: drag between adjacent clips." FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                </StackPanel>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel x:Name="VideoTrackHeadersPanel" />
                        <ScrollViewer x:Name="VideoTimelineScroller" Grid.Column="1" VerticalAlignment="Top" HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled" SizeChanged="VideoTimelineScroller_SizeChanged">
                            <canvas:CanvasVirtualControl
                                x:Name="VideoTimelineCanvas"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                ClearColor="#181B21"
                                RegionsInvalidated="VideoTimelineCanvas_RegionsInvalidated"
                                PointerPressed="VideoTimelineCanvas_PointerPressed"
                                PointerMoved="VideoTimelineCanvas_PointerMoved"
                                PointerReleased="VideoTimelineCanvas_PointerReleased"
                                PointerCaptureLost="VideoTimelineCanvas_PointerCaptureLost" />
                        </ScrollViewer>
                    </Grid>
                </ScrollViewer>
            </Grid>

            <Grid x:Name="AudioTimelineWorkspace" Grid.Row="2" Grid.ColumnSpan="3" Style="{StaticResource PanelStyle}" Padding="12" Visibility="Collapsed" SizeChanged="AudioLayout_SizeChanged">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel x:Name="AudioTrackNamesPanel" Spacing="4" />
                        <StackPanel x:Name="AudioTracksPanel" Grid.Column="1" Spacing="4" />
                    </Grid>
                </ScrollViewer>
            </Grid>

            <Grid x:Name="InkTimelineWorkspace" Grid.Row="2" Grid.ColumnSpan="3" Style="{StaticResource PanelStyle}" Padding="12" RowSpacing="10" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="INK CELS" Style="{StaticResource SectionHeaderTextStyle}" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <Button Click="AddFrame_Click" ToolTipService.ToolTip="Add a cel after the current one" AutomationProperties.Name="Add cel">
                        <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE710;" FontSize="12" /><TextBlock Text="Add cel" /></StackPanel>
                    </Button>
                    <Button x:Name="KeyframeButton" Content="Set keyframe" Click="ToggleKeyframe_Click" />
                    <Button Click="DuplicateFrame_Click" AutomationProperties.Name="Duplicate cel">
                        <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE8C8;" FontSize="12" /><TextBlock Text="Duplicate cel" /></StackPanel>
                    </Button>
                    <Button x:Name="DeleteFrameButton" Click="DeleteFrame_Click" IsEnabled="False" AutomationProperties.Name="Delete cel">
                        <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE74D;" FontSize="12" /><TextBlock Text="Delete cel" /></StackPanel>
                    </Button>
                </StackPanel>
                <ScrollViewer Grid.Row="1" VerticalAlignment="Top" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" VerticalScrollMode="Disabled">
                    <StackPanel x:Name="InkFramesPanel" Orientation="Horizontal" Spacing="4" Height="38" />
                </ScrollViewer>
            </Grid>
            <Thumb x:Name="EditorOptionsGrip" Grid.Column="1" IsTabStop="True" Tag="options"
                   AutomationProperties.Name="Resize options panel" KeyDown="LayoutGrip_KeyDown"
                   PointerPressed="LayoutGrip_PointerPressed"
                   DragDelta="LayoutGrip_DragDelta" DragCompleted="LayoutGrip_DragCompleted"
                   ToolTipService.ToolTip="Drag left/right to resize options. Arrow keys resize; Home restores the default width. View menu hides or restores panels.">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="{StaticResource PanelBorderBrush}" CornerRadius="3" Margin="2,0">
                            <TextBlock Text=":" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>
            <Thumb x:Name="EditorTimelineGrip" Grid.Row="1" Grid.ColumnSpan="3" IsTabStop="True" Tag="timeline"
                   AutomationProperties.Name="Resize preview and timeline" KeyDown="LayoutGrip_KeyDown"
                   PointerPressed="LayoutGrip_PointerPressed"
                   DragDelta="LayoutGrip_DragDelta" DragCompleted="LayoutGrip_DragCompleted"
                   ToolTipService.ToolTip="Drag up/down to resize preview and timeline. Arrow keys resize; Home restores the default split. View menu hides or restores panels.">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="{StaticResource PanelBorderBrush}" CornerRadius="3" Margin="0,2">
                            <TextBlock Text="=" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>
        </Grid>

        <Grid Grid.Row="3" Padding="12,0" Background="{StaticResource ChromeBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,1,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Text="Ready  ·  24 fps" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="WorkspaceStatusText" Grid.Column="1" Text="Video Editor" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
        </Grid>
    </Grid>
</Window>
